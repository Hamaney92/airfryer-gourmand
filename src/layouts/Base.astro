---
import '../styles/global.css';
import { primaryNavigation } from '../lib/primary-navigation.mjs';
import ChristmasTheme from '../components/ChristmasTheme.astro';
import Brand from '../components/Brand.astro';
import AdSenseVerification from '../components/AdSenseVerification.astro';
import AffiliateTracking from '../components/AffiliateTracking.astro';
import ConversionTracking from '../components/ConversionTracking.astro';
import BooksBanner from '../components/BooksBanner.astro';
import { NEWSLETTER_SIGNUP_URL } from '../lib/site';
import NewsletterBanner from '../components/NewsletterBanner.astro';
import NewsletterPopup from '../components/NewsletterPopup.astro';
import ContextualProducts from '../components/ContextualProducts.astro';
import BookOffer from '../components/BookOffer.astro';
import { isEditorialPage, pageOffers, bookFor } from '../lib/commerce';
export interface Props { title: string; description: string; pageType?: string; }
const { title, description, pageType = 'page' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

---
<!DOCTYPE html>
<html lang="fr">
<head>
  <link rel="alternate" type="application/rss+xml" title="Airfryer Gourmand — Recettes" href="/feed.xml" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <ChristmasTheme head />
  <AdSenseVerification />
  <meta name="p:domain_verify" content="4b6b768b180fee1a16cbfade5fb7549f" />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-J24QNEE9GV" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    if (location.hostname === 'airfryergourmand.fr') {
      gtag('js', new Date());
      gtag('config', 'G-J24QNEE9GV');
    }
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <link rel="icon" href="/img/brand/afg-winged-icon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/img/brand/afg-winged-touch.png" sizes="180x180" />
  <slot name="head" />
<noscript><style is:inline>@media(max-width:1100px){header .bar{height:auto;min-height:64px;flex-wrap:wrap;padding-bottom:12px}header .mobile-menu-trigger{display:none}header .cats{display:flex;width:100%;flex-wrap:wrap;gap:4px 16px}header .cats a{display:flex;align-items:center;min-height:44px}}</style></noscript>
</head>
<body data-page-type={pageType}>
  <a class="skip-link" href="#main-content">Aller au contenu</a>
  <header>
    <div class="wrap bar">
      <Brand />
      <nav class="cats" id="primary-navigation" aria-label="Navigation principale">
 {primaryNavigation.map(([label, href]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined} data-book-entry={href === '/livre/' ? '' : undefined} data-placement={href === '/livre/' ? 'header' : undefined} data-page-type={href === '/livre/' ? pageType : undefined}>{label}</a>)}
 </nav>
      <button class="icobtn mobile-menu-trigger" type="button" aria-label="Ouvrir le menu" aria-controls="primary-navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>
  <BooksBanner pageType={pageType} />
  <NewsletterBanner pageType={pageType} />
  <ChristmasTheme />
  <main id="main-content" tabindex="-1">
    <slot />
    {isEditorialPage(Astro.url.pathname) && <div class="wrap">
      <ContextualProducts offers={pageOffers(Astro.url.pathname)} pageId={Astro.url.pathname} pageType={pageType} />
      <BookOffer kind={bookFor(Astro.url.pathname)} pageId={Astro.url.pathname} pageType={pageType} />
    </div>}
  </main>
  <footer>
    <div class="wrap">
      <div class="fgrid">
        <div>
          <Brand inverse />
          <p style="color:#b6a99d;font-size:.9rem;max-width:280px">Le guide francophone pour tout réussir avec ton air fryer : recettes, temps de cuisson et guides d'achat.</p>
        </div>
        <div><h4>Recettes</h4><a href="/categorie/viandes/">Viandes</a><a href="/categorie/poissons/">Poissons</a><a href="/categorie/surgeles/">Surgelés</a><a href="/categorie/desserts/">Desserts</a></div>
        <div><h4>Outils</h4><a href="/temps-de-cuisson/">Temps de cuisson</a><a href="/temps-de-cuisson/">Convertisseur four</a><a href="/guides/">Guides d'achat</a></div>
        <div><h4>Le site</h4><a href="/a-propos/">À propos</a><a href="/contact/">Contact</a><a href={NEWSLETTER_SIGNUP_URL} data-newsletter-signup data-lead-source={`footer_${pageType}`}>Newsletter recettes et offres</a><a href="/mentions-legales/">Mentions légales</a><a href="/confidentialite/">Confidentialité</a></div>
      </div>
      <p class="disc">Certains liens sont des liens d'affiliation : si tu achètes via eux, on touche une petite commission sans surcoût pour toi. © 2026 Airfryer Gourmand · airfryergourmand.fr</p>
    </div>
  </footer>
  <AffiliateTracking />
  <ConversionTracking />
  <NewsletterPopup automatic={isEditorialPage(Astro.url.pathname) || Astro.url.pathname === '/'} />
  <script>
    import { initSiteNavigation } from '../lib/site-navigation.mjs';
    initSiteNavigation();
  </script>
</body>
</html>
