---
import Layout from '../layouts/Layout.astro';
import { NEWSLETTER_FORM_URL } from '../lib/site';
---
<Layout title="Des idées air fryer chaque semaine — Airfryer Gourmand" description="Recevez chaque semaine des idées de recettes et conseils air fryer pour varier vos repas. Inscription facultative, désinscription à tout moment." pageType="newsletter" noindex>
  <section class="wrap newsletter-page">
    <h1>Et pour vos prochains repas ?</h1>
    <p class="newsletter-benefit">Un email par semaine avec des recettes et conseils air fryer pour varier vos repas.</p>
    <p>La newsletter présente aussi nos livres et des recommandations de produits, parfois affiliées. Inscription facultative, désinscription à tout moment. <a href="/confidentialite/">Confidentialité</a>.</p>
    <iframe src={NEWSLETTER_FORM_URL} title="Formulaire newsletter Airfryer Gourmand" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </section>
</Layout>
<style>.newsletter-page{max-width:740px;padding-top:30px;padding-bottom:30px}.newsletter-page iframe{width:100%;height:720px;border:0}.newsletter-page p{color:var(--muted);font-size:.9rem}.newsletter-page .newsletter-benefit{color:var(--ink);font-size:1.1rem;line-height:1.6}</style>
