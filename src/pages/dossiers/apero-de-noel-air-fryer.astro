---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const pub = new Set((await getCollection('recipes')).filter((r) => r.data.pubDate.getTime() <= Date.now()).map((r) => r.id));
const isLive = (url) => pub.has(url.split('/').filter(Boolean).pop());

const familles = [
  {
    titre: "Croustillants du monde",
    items: [
      ['🔺', 'Samoussas', '/recettes/samoussa-air-fryer/', '180 °C · 12 min'],
      ['🥟', 'Nems', '/recettes/nems-surgeles-air-fryer/', '180 °C · 10-12 min'],
      ['🍤', 'Accras de morue', '/recettes/accras-air-fryer/', '180 °C · 10 min'],
    ],
  },
  {
    titre: "Panés & fondants",
    items: [
      ['🧀', 'Bâtonnets de mozzarella', '/recettes/batonnets-de-mozzarella-air-fryer/', '200 °C · 6-8 min'],
      ['🧀', 'Halloumi', '/recettes/halloumi-air-fryer/', '200 °C · 8-10 min'],
      ['🧀', 'Camembert rôti', '/recettes/camembert-roti-air-fryer/', '180 °C · 8 min'],
      ['🧀', 'Feta rôtie', '/recettes/feta-rotie-air-fryer/', '180 °C · 10 min'],
    ],
  },
  {
    titre: "Feuilletés & toasts",
    items: [
      ['🥐', 'Roulés feuilletés', '/recettes/roules-feuilletes-air-fryer/', '180 °C · 12 min'],
      ['🍅', 'Bruschetta', '/recettes/bruschetta-air-fryer/', '180 °C · 5-6 min'],
      ['🍤', 'Gambas', '/recettes/gambas-air-fryer/', '200 °C · 6-8 min'],
    ],
  },
  {
    titre: "La touche sucrée de fin d'apéro",
    items: [
      ['🍩', 'Churros', '/recettes/churros-air-fryer/', '180 °C · 10 min'],
    ],
  },
];

const famillesLive = familles.map(f => ({ ...f, items: f.items.filter(it => isLive(it[2])) })).filter(f => f.items.length);
const nombre = famillesLive.reduce((total, f) => total + f.items.length, 0);
const title = `Apéro de Noël à l'air fryer : ${nombre} idées et ordre des fournées`;
const description = `${nombre} recettes disponibles pour l'apéro de Noël au air fryer : bouchées, fromages et idées sucrées. Choisir les recettes et organiser les fournées.`;
const articleSchema = {
  "@context": "https://schema.org", "@type": "Article",
  "headline": title, "description": description,
  "author": { "@type": "Organization", "name": "L'équipe Airfryer Gourmand", "url": "https://airfryergourmand.fr/a-propos/" },
  "publisher": { "@type": "Organization", "name": "Airfryer Gourmand", "url": "https://airfryergourmand.fr/" },
  "dateModified": "2026-10-28",
};
const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Combien de pièces d'apéro par personne prévoir ?", "acceptedAnswer": { "@type": "Answer", "text": "Pour un apéro dînatoire de Noël, comptez 10 à 14 pièces salées par personne (6 à 8 si c'est un simple apéritif avant le repas), en variant 4 à 6 recettes différentes." } },
    { "@type": "Question", "name": "Peut-on préparer l'apéro de Noël à l'avance à l'air fryer ?", "acceptedAnswer": { "@type": "Answer", "text": "Préparez seulement à l'avance ce que la recette et la conservation des ingrédients permettent. Gardez les produits périssables au froid et cuisez les bouchées par fournées. Pour les produits surgelés, suivez l'emballage : un simple réchauffage ne remplace pas une cuisson." } },
  ],
};
---
<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="wrap">
    <article class="article">
      <div class="crumb" style="color:#9a8c7d;font-size:.9rem;margin-bottom:10px">
        <a href="/" style="color:var(--accent);text-decoration:none">Accueil</a> › Dossiers › Apéro de Noël
      </div>
      <h1>{title}</h1>
      <div class="byline" style="display:flex;align-items:center;gap:9px;color:var(--muted);font-size:.9rem;margin:6px 0 16px">
        <span aria-hidden="true">🍟</span>
        <span>Par <a href="/a-propos/" style="color:var(--brand-d);font-weight:700">L'équipe Airfryer Gourmand</a> · Mis à jour le 28 octobre 2026</span>
      </div>

      <div class="quick"><b>En bref :</b> choisis quelques recettes et prévois plusieurs fournées en une seule couche. Cette sélection compte {nombre} idées dont les fiches sont disponibles. Le panier peut compléter le four, mais ne cuit pas tout un buffet en une seule fois.</div>

      <p>À Noël, l'air fryer peut prendre en charge une partie de l'apéritif pendant que le four sert au plat. Voici une sélection de {nombre} idées, du samoussa au camembert rôti. Pour poursuivre le repas, consulte notre <a href="/dossiers/menu-noel-air-fryer/">menu de Noël et son organisation</a>.</p>

      <h2>Pourquoi l'air fryer est parfait pour l'apéro de Noël</h2>
      <p>L'air fryer permet de cuire de petites fournées sans bain de friture et de réserver le four à une autre préparation. Cela ne garantit pas qu'une bouchée soit moins calorique : la pâte, la farce et la quantité d'huile comptent. Il faut aussi tenir compte des odeurs et du nettoyage selon les aliments.</p>

      {famillesLive.map((f) => (
        <>
          <h2>{f.titre}</h2>
          <div class="cards" style="margin-top:12px">
            {f.items.map(([e, nom, url, reglage]) => (
              <div class="rcard" style="cursor:default">
                <div class="ph" style="height:90px"><span style="font-size:1.7rem">{e}</span></div>
                <div style="padding:12px 15px 16px">
                  <a class="rtitle" href={url} style="color:var(--brand-d);font-weight:700;text-decoration:none">{nom} →</a>
                  <p style="margin:8px 0 0"><span class="chip" style="background:var(--cream);color:var(--brand-d);padding:3px 9px;border-radius:20px;font-size:.8rem;font-weight:700">{reglage}</span></p>
                </div>
              </div>
            ))}
          </div>
        </>
      ))}

      <h2>Comment organiser son apéro de Noël à l'air fryer</h2>
      <ul>
        <li><b>Quantités :</b> 10 à 14 pièces salées par personne pour un apéro dînatoire (6 à 8 avant un repas).</li>
        <li><b>La veille :</b> prépare seulement ce que la fiche et les ingrédients permettent de conserver ; garde les produits périssables au froid.</li>
        <li><b>Le jour J :</b> cuis par fournées en une seule couche, en commençant par ce qui se garde au chaud (feuilletés, panés) et en finissant par ce qui se mange brûlant (fromages fondants).</li>
        <li><b>Au service :</b> présente de petites quantités et sers les fournées cuites rapidement. Pour les produits du commerce, suis les consignes de l'emballage.</li>
      </ul>

      <div class="card-box" style="background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 24px;margin:24px 0">
        <div style="font-weight:800;color:var(--brand-d);margin-bottom:6px">💬 Le mot de la rédaction</div>
        <p style="color:#5f5147;margin:0">Organisation proposée, sans essai de buffet complet par notre équipe : choisis quelques recettes, vérifie leur conservation et note l'ordre des fournées. Un essai avec ton appareil avant les fêtes permet de mesurer la place réelle dans le panier.</p>
      </div>

      <h2>Questions fréquentes</h2>
      <h3>Combien de pièces par personne prévoir ?</h3>
      <p>10 à 14 pièces salées par personne pour un apéro dînatoire, 6 à 8 avant un repas, en variant 4 à 6 recettes.</p>
      <h3>Peut-on préparer l'apéro à l'avance ?</h3>
      <p>Prépare seulement à l'avance ce que la recette et la conservation des ingrédients permettent. Garde les produits périssables au froid et cuis les bouchées par fournées. Pour les produits surgelés, suis l'emballage : un simple réchauffage ne remplace pas une cuisson.</p>

      <p style="margin-top:26px"><a class="cta" href="/categorie/apero/">🧀 Voir toutes les recettes apéro</a></p>
    </article>
  </div>
</Base>
