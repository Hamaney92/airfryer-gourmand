---
import Layout from '../../layouts/Layout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import SaveRecipe from '../../components/SaveRecipe.astro';
import { render } from 'astro:content';
import { SITE, catInfo, isoDuration, totalTime, fmtDate, getPublishedRecipes, amazonSearch, amazonProduct, gearFor, pairingCategories, isMinceur } from '../../lib/site';

export async function getStaticPaths() {
  const recipes = await getPublishedRecipes();
  return recipes.map((recipe) => ({
    params: { slug: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { data } = recipe;
const cat = catInfo(data.category);
const lightRecipe = isMinceur(recipe);
const path = `/recettes/${recipe.id}/`;
const { Content } = await render(recipe);

const gear = gearFor({ category: data.category, slug: recipe.id, keyword: data.keyword });
const gearUrl = gear.asin ? amazonProduct(gear.asin) : amazonSearch(gear.query);

const allPublished = await getPublishedRecipes();
const autres = allPublished.filter((r) => r.id !== recipe.id);

// Sortie n°1 — la suite logique du repas (intention réelle : « et avec ça ? »).
const pairing = pairingCategories(data.category);
const pairingRecipes = pairing
  ? autres.filter((r) => pairing.cats.includes(r.data.category)).slice(0, 4)
  : [];
const dejaVus = new Set(pairingRecipes.map((r) => r.id));

// Sortie n°2 — plus de recettes du même genre, en évitant les doublons de la 1re section.
const sameCat = autres.filter((r) => r.data.category === data.category && !dejaVus.has(r.id));
const others = autres.filter((r) => r.data.category !== data.category && !dejaVus.has(r.id));
const related = [...sameCat, ...others].slice(0, 4);

const imageUrl = data.image ? new URL(data.image, SITE.url).href : undefined;

// Versions WebP optimisées (générées dans /img/w/) : <nom>-380.webp et <nom>-760.webp.
// On garde le JPG original en fallback + pour og:image / JSON-LD.
const imgName = data.image ? data.image.replace(/^\/img\//, '').replace(/\.jpg$/, '') : undefined;
const webp380 = imgName ? `/img/w/${imgName}-380.webp` : undefined;
const webp760 = imgName ? `/img/w/${imgName}-760.webp` : undefined;

// --- JSON-LD : Recipe + FAQPage + BreadcrumbList (résultats enrichis Google) ---
const recipeLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: data.title,
  description: data.description,
  ...(imageUrl ? { image: [imageUrl] } : {}),
  author: { '@type': 'Organization', name: data.author },
  datePublished: data.pubDate.toISOString().split('T')[0],
  ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString().split('T')[0] } : {}),
  recipeCategory: cat.label,
  recipeCuisine: 'Française',
  keywords: data.keyword,
  prepTime: isoDuration(data.prepTime),
  cookTime: isoDuration(data.cookTime),
  totalTime: isoDuration(totalTime(recipe)),
  recipeYield: `${data.servings} portions`,
  recipeIngredient: data.ingredients,
  recipeInstructions: data.steps.map((s: string, i: number) => ({
    '@type': 'HowToStep',
    position: i + 1,
    text: s,
  })),
};

const faqLd =
  data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((f: { q: string; a: string }) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Recettes', item: SITE.url + '/recettes/' },
    { '@type': 'ListItem', position: 3, name: cat.label, item: `${SITE.url}/categorie/${cat.slug}/` },
    { '@type': 'ListItem', position: 4, name: data.title, item: SITE.url + path },
  ],
};

const jsonLd = [recipeLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])];
---
<Layout
  title={data.metaTitle ?? data.title}
  description={data.description}
  path={path}
  image={data.image}
  jsonLd={jsonLd}
  pageType="recipe"
>
  <article class="article wrap">
    <nav class="crumb">
      <a href="/">Accueil</a> › <a href="/recettes/">Recettes</a> ›
      <a href={`/categorie/${cat.slug}/`}>{cat.label}</a> › {data.title}
    </nav>

    <h1>{data.title}</h1>

    <div class="byline">
      <span class="by-av">👩‍🍳</span>
      <span>Par <a href="/a-propos/">{data.author}</a> · Publié le {fmtDate(data.pubDate)}
        {data.updatedDate && <> · Mis à jour le {fmtDate(data.updatedDate)}</>}</span>
    </div>

    <div class="amETA">
      <span class="chip">⏱ Prépa {data.prepTime} min</span>
      <span class="chip">🔥 Cuisson {data.cookTime} min</span>
      <span class="chip">🌡 {data.temp}</span>
      <span class="chip">🍽 {data.servings} pers.</span>
    </div>

    <a href="#recette" class="jump">↓ Aller au temps de cuisson</a>

    {data.image ? (
      <picture>
        <source type="image/webp" srcset={`${webp380} 380w, ${webp760} 760w`} sizes="(max-width: 800px) 100vw, 760px" />
        <img src={data.image} alt={data.alt ?? data.title} width="760" height="320" style="height:320px;object-fit:cover;border-radius:18px;margin-bottom:22px" fetchpriority="high" decoding="async" />
      </picture>
    ) : (
      <div class="ph" style="height:320px;border-radius:18px;margin-bottom:22px"><span>Photo à venir</span></div>
    )}

    <div class="quick" id="recette">
      <b>Réponse rapide —</b> {data.quickAnswer}
    </div>

    <aside class="cooking-table-link" aria-label="Tableau de cuisson Air Fryer">
      <span aria-hidden="true">⏱️</span>
      <p>Vous cherchez le temps ou la température d’un autre aliment ? Consultez notre <a href="/tableau-temps-cuisson-air-fryer/">tableau de cuisson air fryer</a> : les réglages essentiels y sont réunis.</p>
    </aside>

    {lightRecipe && (
      <aside class="light-recipes-link" aria-label="Recettes minceur Air Fryer express">
        <span aria-hidden="true">🥗</span>
        <p>Cette recette fait partie de nos idées légères. Découvrez d’autres <a href="/dossiers/recettes-minceur-air-fryer/">recettes minceur air fryer express</a>, prêtes en 15 minutes ou moins.</p>
      </aside>
    )}

    {/* `#materiel` est aussi la cible des e-mails MailerLite : l'e-mail reste sans lien
        affilié et renvoie vers cet encart visible, placé ici après la réponse à l'intention. */}
    <aside id="materiel" class="gear-box gear-box--primary" aria-label={`Accessoire recommandé : ${gear.nom}`}>
      <div class="gear-box__eyebrow">{gear.emoji} Pour la réussir à coup sûr</div>
      <div class="gear-box__title">{gear.nom}</div>
      <p>{gear.util}</p>
      {gear.href ? (
        <a href={gear.href} class="gear-box__cta">Voir le comparatif →</a>
      ) : (
        <a href={gearUrl} target="_blank" rel="sponsored nofollow noopener" data-affiliate-network="amazon" data-product-name={gear.model || gear.nom} data-product-asin={gear.asin} data-placement="recipe_primary_gear" data-page-type="recipe" data-page-id={recipe.id} class="gear-box__cta">
          {gear.model ? `Voir ${gear.model} sur Amazon →` : "Voir l'accessoire recommandé sur Amazon →"}
        </a>
      )}
      {gear.fitNote && <p class="gear-box__fit">À vérifier : {gear.fitNote}</p>}
      {gear.fitNote && <p class="gear-box__fallback"><a href={amazonSearch(gear.query)} target="_blank" rel="sponsored nofollow noopener" data-affiliate-network="amazon" data-product-name={gear.nom} data-placement="recipe_primary_gear_fallback" data-page-type="recipe" data-page-id={recipe.id}>Ton panier a une autre taille ? Voir les modèles compatibles →</a></p>}
      {!gear.href && <p class="gear-box__disclosure">Lien affilié : une commission peut nous être versée, sans surcoût pour vous.</p>}
      <p class="gear-box__guide"><a href="/guides/accessoires-air-fryer/">Voir tous les accessoires vraiment utiles →</a></p>
    </aside>

    <!-- Corps de l'article (markdown) -->
    <Content />

    <div class="card-box">
      <h2 style="margin-top:0">Ingrédients</h2>
      <ul>{data.ingredients.map((i: string) => <li>{i}</li>)}</ul>
      <SaveRecipe titre={data.title} url={new URL(path, SITE.url).href} />

      <h2>Étapes</h2>
      <ol>{data.steps.map((s: string) => <li>{s}</li>)}</ol>
      {data.tips.length > 0 && (
        <>
          <h3>Astuces</h3>
          <ul>{data.tips.map((t: string) => <li>{t}</li>)}</ul>
        </>
      )}
    </div>

    {data.servings <= 2 && (
      <aside class="book-recipe-box">
        <div aria-hidden="true" class="book-recipe-icon">📖</div>
        <div>
          <strong>Vous cuisinez souvent pour une ou deux personnes ?</strong>
          <p>Notre livre réunit 100 recettes avec les bonnes quantités, les temps et les températures déjà calculés.</p>
          <a href="/livre/" data-book-entry data-placement="recipe_after_gear" data-page-type="recipe" data-page-id={recipe.id}>Découvrir le livre →</a>
        </div>
      </aside>
    )}

    {/*
      Chaque question est un H2 à part entière, dans le fil de l'article — et non des H3
      empilés sous un « Questions fréquentes » générique. Les gens tapent leur question
      telle quelle dans Google (« combien de temps cuire… ») : un H2 qui reprend
      exactement cette formulation est ce que Google retient pour les extraits enrichis.
      Un titre générique, lui, ne correspond à aucune recherche.
    */}
    {data.faq.length > 0 && (
      <section class="faq">
        {data.faq.map((f: { q: string; a: string }) => (
          <>
            <h2>{f.q}</h2>
            <p>{f.a}</p>
          </>
        ))}
      </section>
    )}

    {data.note && <p class="note">{data.note}</p>}

    <div class="author-box">
      <div class="author-av">👩‍🍳</div>
      <div>
        <div class="author-name">{data.author}</div>
        <p>Nous rassemblons les temps, températures, pièges et variantes utiles pour rendre chaque cuisson plus simple. <a href="/a-propos/">En savoir plus →</a></p>
      </div>
    </div>

    {pairing && pairingRecipes.length > 0 && (
      <section>
        <div class="row"><div class="h2">{pairing.titre}</div></div>
        <div class="cards">{pairingRecipes.map((r) => <RecipeCard recipe={r} />)}</div>
      </section>
    )}

    {related.length > 0 && (
      <section>
        <div class="row"><div class="h2">À tester juste après</div></div>
        <div class="cards">{related.map((r) => <RecipeCard recipe={r} />)}</div>
      </section>
    )}
  </article>
</Layout>

<style>
  .gear-box--primary{background:linear-gradient(135deg,var(--cream,#fff7ef),#fff);border:1px solid var(--line);border-radius:16px;padding:18px 22px;margin:14px 0 26px;scroll-margin-top:80px;box-shadow:var(--shadow)}
  .gear-box__eyebrow{font-size:.82rem;font-weight:800;color:var(--brand-d);text-transform:uppercase;letter-spacing:.02em}
  .gear-box__title{font-size:1.15rem;font-weight:850;color:var(--ink);margin-top:3px}
  .gear-box--primary p{margin:7px 0;color:#5f5147}
  .gear-box__cta{display:inline-flex;align-items:center;justify-content:center;background:#ff9900;color:#111;font-weight:850;text-decoration:none;padding:11px 18px;border-radius:10px;margin:5px 0;min-height:44px}
  .gear-box__disclosure{font-size:.78rem;color:#7d7065!important}
  .gear-box__fit{font-size:.82rem!important;color:#685c51!important}
  .gear-box__fallback{font-size:.86rem}.gear-box__fallback a{color:var(--brand-d);font-weight:750}
  .gear-box__guide{font-size:.88rem}.gear-box__guide a{color:var(--brand-d);font-weight:750}
  .cooking-table-link{display:flex;gap:10px;align-items:flex-start;background:#f4f9f7;border-left:4px solid var(--brand);border-radius:10px;padding:12px 15px;margin:14px 0 20px}
  .cooking-table-link span{font-size:1.1rem;line-height:1.45}.cooking-table-link p{margin:0;color:#40564c;font-size:.93rem}.cooking-table-link a{color:var(--brand-d);font-weight:800}
  .light-recipes-link{display:flex;gap:10px;align-items:flex-start;background:#fff8ed;border-left:4px solid #f0a647;border-radius:10px;padding:12px 15px;margin:14px 0 20px}
  .light-recipes-link span{font-size:1.1rem;line-height:1.45}.light-recipes-link p{margin:0;color:#685438;font-size:.93rem}.light-recipes-link a{color:var(--brand-d);font-weight:800}
  .book-recipe-box{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start;background:var(--cream);border:1px solid #ffd6b8;border-radius:16px;padding:18px 20px;margin:22px 0}
  .book-recipe-icon{font-size:1.8rem}
  .book-recipe-box p{margin:4px 0 7px;color:#5f5147;font-size:.93rem}
  .book-recipe-box a{color:var(--brand-d);font-weight:800}
</style>
