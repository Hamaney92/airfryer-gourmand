---
// Page dédiée au mot-clé n°1 de la niche air fryer : « tableau des temps de cuisson à imprimer ».
// Chez tous les gros blogs air fryer anglophones, c'est la page la plus vue, la plus épinglée
// et le premier capteur d'emails. On lui donne sa propre page (au lieu d'un bloc perdu sur
// /temps-de-cuisson/) pour qu'elle puisse ranker seule et servir d'aimant.
import Layout from '../layouts/Layout.astro';
import { SITE, getPublishedRecipes, catInfo } from '../lib/site';
import NewsletterForm from '../components/NewsletterForm.astro';

const recipes = await getPublishedRecipes();
const rows = recipes
  .map((r) => ({
    nom: r.data.title.split(' au air fryer')[0].split(' à l')[0].split(' :')[0],
    slug: r.id,
    cat: catInfo(r.data.category).label,
    temp: r.data.temp,
    cook: r.data.cookTime,
    servings: r.data.servings,
  }))
  .filter((r) => r.temp && r.cook)
  .sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));

const parCat = rows.reduce((acc: Record<string, typeof rows>, r) => {
  (acc[r.cat] ||= []).push(r);
  return acc;
}, {});

const categoryId = (label: string) => 'cuisson-' + label.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-');

const title = 'Tableau des temps de cuisson air fryer à imprimer (PDF gratuit)';
const description =
  "Tableau de cuisson Air Fryer gratuit : temps et températures pour frites, viandes, légumes, poisson et surgelés. À imprimer et coller sur le frigo.";

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: `${SITE.url}/tableau-temps-cuisson-air-fryer/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Quelle température pour cuire au air fryer ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "La plupart des cuissons se font entre 160 °C et 200 °C. 200 °C pour tout ce qui doit croustiller (frites, panés, ailes de poulet), 180 °C pour les viandes et les plats complets, 160 °C pour les desserts et les gâteaux.",
        },
      },
      {
        '@type': 'Question',
        name: 'Comment convertir une recette du four vers le air fryer ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Baissez la température d'environ 20 °C et réduisez le temps d'environ 20 %. Une recette prévue 30 minutes à 200 °C au four devient environ 24 minutes à 180 °C au air fryer. Vérifiez toujours la cuisson avant de servir.",
        },
      },
      {
        '@type': 'Question',
        name: 'Faut-il préchauffer un air fryer ?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: "Cela dépend du modèle et de la recette. Suivez la notice de votre appareil : certains programmes préchauffent automatiquement, d'autres n'en ont pas besoin.",
        },
      },
    ],
  },
];
---

<Layout title={title} description={description} path="/tableau-temps-cuisson-air-fryer/" jsonLd={jsonLd}>
  <div class="wrap article">
    <h1>Tableau de cuisson air fryer à imprimer : PDF gratuit</h1>
    <p>
      Retrouvez {rows.length} préparations avec leur température, leur temps de cuisson indicatif et le lien vers la recette.
      Le tableau en français est consultable ici et disponible en PDF gratuit, sans inscription obligatoire.
      Adaptez les réglages à la quantité et à votre appareil ; les consignes du fabricant restent prioritaires.
    </p>

    <aside class="magnet">
      <div class="magnet-txt">
        <strong>📄 La version à imprimer, gratuite</strong>
        <p>Une seule page, à coller sur la porte du frigo. Plus besoin de toucher ton téléphone avec les mains pleines de farine.</p>
        <a href="/tableau-temps-cuisson-air-fryer.pdf" download class="magnet-cta" data-placement="cooking_times_page">Télécharger le PDF gratuit →</a>
        <p style="margin:10px 0;color:var(--muted);font-size:.85rem">Sans inscription ni email obligatoire.</p>
        <details><summary style="cursor:pointer;padding:12px 0;font-weight:700">Recevoir le tableau et m’abonner à la newsletter</summary><NewsletterForm title="Tableau des temps de cuisson" url={`${SITE.url}/tableau-temps-cuisson-air-fryer.pdf`} source="cooking_times_page" /></details>
      </div>
    </aside>

    <section class="table-navigation" aria-label="Trouver un temps de cuisson">
      <nav aria-label="Catégories du tableau">
        {Object.keys(parCat).map((cat) => <a href={'#' + categoryId(cat)}>{cat}</a>)}
      </nav>
      <div class="table-search" hidden>
        <label for="food-search">Rechercher un aliment dans le tableau</label>
        <input id="food-search" type="search" placeholder="Ex. nems, poulet, poivrons…" autocomplete="off" />
        <p id="food-search-status" role="status" aria-live="polite"></p>
      </div>
    </section>

    {Object.entries(parCat).map(([cat, list]) => (
      <section data-cooking-category>
        <h2 id={categoryId(cat)}>{cat}</h2>
        <div style="overflow-x:auto">
          <table class="rectable">
            <thead><tr><th>Aliment</th><th>Portions</th><th>Température</th><th>Temps</th><th></th></tr></thead>
            <tbody>
              {list.map((r) => (
                <tr data-food={r.nom}>
                  <td>{r.nom}</td>
                  <td>{r.servings ? `${r.servings} pers.` : '—'}</td>
                  <td class="t">{r.temp}</td>
                  <td style="font-weight:700;white-space:nowrap">{r.cook} min</td>
                  <td><a href={`/recettes/${r.slug}/`} style="color:var(--brand-d);font-weight:700;white-space:nowrap" aria-label={`Recette : ${r.nom}`}>La recette →</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <section aria-labelledby="choisir-outil">
      <h2 id="choisir-outil">PDF à imprimer ou convertisseur : quel outil utiliser ?</h2>
      <p>Le PDF gratuit sert de mémo à conserver en cuisine. Le tableau de cette page donne accès aux recettes détaillées, avec leurs quantités et précautions. Pour adapter une durée indiquée dans une recette au four, utilise plutôt le <a href="/temps-de-cuisson/">convertisseur four vers air fryer</a> : son résultat reste un point de départ à contrôler pendant la cuisson.</p>
      <p>Pour commencer : <a href="/recettes/nems-surgeles-air-fryer/">nems surgelés</a>, <a href="/recettes/samoussas-surgeles-air-fryer/">samoussas surgelés</a>, <a href="/recettes/escalope-de-poulet-air-fryer/">escalopes de poulet</a> et <a href="/recettes/dinde-air-fryer/">dinde</a>.</p>
    </section>
    <aside aria-label="Livres de recettes">
      <h2>Envie d'idées de repas, au-delà des temps de cuisson ?</h2>
      <p>Le mémo reste gratuit et accessible sans inscription. Pour découvrir nos deux livres et choisir celui qui correspond à ta cuisine, consulte <a href="/livre/" data-book-entry data-placement="cooking_table_after_content" data-page-type="tool">nos livres de recettes au air fryer</a>.</p>
    </aside>

    <h2>Questions fréquentes</h2>
    <h3>Quelle température pour cuire au air fryer ?</h3>
    <p>La plupart des cuissons se font entre 160 °C et 200 °C. <b>200 °C</b> pour tout ce qui doit croustiller (frites, panés, ailes de poulet), <b>180 °C</b> pour les viandes et les plats complets, <b>160 °C</b> pour les desserts et les gâteaux.</p>

    <h3>Comment convertir une recette du four vers le air fryer ?</h3>
    <p>Baissez la température d'environ 20 °C et réduisez le temps d'environ 20 %. Une recette prévue 30 minutes à 200 °C au four devient environ 24 minutes à 180 °C au air fryer. Le <a href="/temps-de-cuisson/">convertisseur</a> fait le calcul pour vous.</p>

    <h3>Faut-il préchauffer un air fryer ?</h3>
    <p>Cela dépend du modèle et de la recette. Suivez la notice de votre appareil : certains programmes préchauffent automatiquement, d'autres n'en ont pas besoin.</p>

    <p class="note">Valeurs indicatives : elles varient selon le modèle, la quantité et l'épaisseur des morceaux. Vérifiez toujours la cuisson avant de servir.</p>
  </div>
</Layout>

<script>
  const search = document.querySelector<HTMLInputElement>('#food-search');
  const searchBox = document.querySelector<HTMLElement>('.table-search');
  const status = document.querySelector<HTMLElement>('#food-search-status');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-cooking-category]'));
  const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  if (search && searchBox && status) {
    searchBox.hidden = false;
    search.addEventListener('input', () => {
      const query = normalize(search.value);
      let count = 0;
      for (const section of sections) {
        let matches = 0;
        for (const row of section.querySelectorAll<HTMLTableRowElement>('tr[data-food]')) {
          const found = normalize(row.dataset.food || '').includes(query);
          row.hidden = !found;
          if (found) matches += 1;
        }
        section.hidden = matches === 0;
        count += matches;
      }
      status.textContent = query ? (count ? count + ' préparation(s) trouvée(s).' : 'Aucun aliment trouvé. Essayez un nom plus court.') : '';
    });
  }
</script>

<style>
  .table-navigation nav{display:flex;flex-wrap:wrap;gap:8px 16px;margin:20px 0}
  .table-navigation nav a{display:inline-flex;align-items:center;min-height:44px;font-weight:700;color:var(--brand-d)}
  .table-search label{display:block;font-weight:700;margin-bottom:8px}
  .table-search input{width:100%;max-width:480px;padding:12px;border:1px solid var(--line);border-radius:10px;font:inherit}
  [data-cooking-category] h2{scroll-margin-top:100px}
  @media print{.table-navigation{display:none}}
  .magnet-form{display:flex;gap:10px;flex-wrap:wrap;margin-top:4px}
  .magnet-form input{flex:1;min-width:200px;border:1px solid var(--line);padding:12px 14px;border-radius:10px;font-size:1rem}
  .magnet-form button{background:var(--brand);color:#fff;font-weight:800;border:none;padding:12px 20px;border-radius:10px;cursor:pointer;font-size:1rem}
  @media(max-width:560px){ .magnet-form button{width:100%} }
</style>
