---
import Base from '../../layouts/Base.astro';

const guides = [
  ['choisir', 'Meilleur air fryer 2026', 'Notre comparatif des modèles selon vos besoins et votre budget.', '/guides/meilleur-air-fryer-2026/'],
  ['double-panier', 'Meilleur air fryer double panier', 'Deux tiroirs pour cuire deux plats à la fois : les modèles familiaux et leurs différences.', '/guides/meilleur-air-fryer-double-panier/'],
  ['familial', 'Air fryer XXL & familial', 'Les grandes capacités pour les familles nombreuses et les grandes tablées.', '/guides/air-fryer-xxl-familial/'],
  ['accessoires', 'Accessoires air fryer indispensables', 'Moules, papiers cuisson perforés, grilles… les usages et compatibilités à vérifier.', '/guides/accessoires-air-fryer/'],
  ['marques', 'Ninja, Moulinex ou Philips ?', 'On compare les grandes marques pour vous aider à choisir selon vos besoins.', '/guides/ninja-moulinex-philips/'],
];
---
<Base title="Guides d'achat air fryer 2026 — Quel modèle choisir ?" description="Nos guides d'achat air fryer : comment choisir, comparatifs des meilleurs modèles (simple, double panier, XXL) et accessoires indispensables. Pour chaque budget.">
  <div class="wrap">
    <section style="padding-top:26px">
      <div class="crumb" style="color:#9a8c7d;font-size:.9rem;margin-bottom:10px">
        <a href="/" style="color:var(--accent);text-decoration:none">Accueil</a> › Guides d'achat
      </div>
      <div class="row"><h1 class="h2">Guides d'achat air fryer<small>Choisir le bon modèle, sans se tromper</small></h1></div>
      <p style="max-width:760px;color:#6a5d54;margin:0 0 22px">
        Simple, double panier, XXL… tous les air fryers ne se valent pas. Avant d'acheter, regarde surtout
        la <b>capacité</b> (3–4 L pour 1–2 personnes, 5–6 L pour une famille, 7 L et + pour les grandes tablées),
        la <b>puissance</b> (idéalement 1500 W et plus pour bien croustiller), la <b>facilité de nettoyage</b>
        (panier compatible lave-vaisselle et revêtement anti-adhésif) et les <b>programmes</b> utiles. Nos guides
        détaillés vous aident à comparer ces critères.
      </p>

      <div class="cards">
        {guides.map(([visual, t, d, url]) => (
          <div class="rcard">
            <a href={url} tabindex="-1" aria-hidden="true"><img class="guide-visual" src={`/img/guides/${visual}-photo-720.webp`} srcset={`/img/guides/${visual}-photo-360.webp 360w, /img/guides/${visual}-photo-720.webp 720w`} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 270px" alt="" width="720" height="405" loading="lazy" decoding="async" /></a>
            <div style="padding:14px 16px 18px">
              <span class="rtag">{url ? 'Guide d\'achat' : 'Guide d\'achat · à venir'}</span>
              {url
                ? <h2 class="rtitle" style="margin-top:8px"><a href={url} style="color:var(--brand-d);text-decoration:none">{t} →</a></h2>
                : <h2 class="rtitle" style="margin-top:8px">{t}</h2>}
              <p style="color:#6a5d54;font-size:.92rem;margin:6px 0 0">{d}</p>
            </div>
          </div>
        ))}
      </div>

      <p class="image-note">Visuels d’illustration générés par IA : appareils génériques, sans représentation d’un modèle de marque précis.</p>

      <div class="tool" style="margin-top:34px">
        <div class="txt">
          <span class="badge">Votre aide en cuisine</span>
          <h3>Trouve le bon temps de cuisson</h3>
          <p>Quel que soit ton modèle, notre convertisseur four → air fryer et le tableau des temps de cuisson te donnent les bons réglages pour chaque aliment.</p>
          <a class="cta" href="/temps-de-cuisson/">Ouvrir l'outil →</a>
        </div>
        <img class="tool-photo" src="/img/guides/temps-cuisson-photo-1000.webp" srcset="/img/guides/temps-cuisson-photo-600.webp 600w, /img/guides/temps-cuisson-photo-1000.webp 1000w" sizes="(max-width: 760px) 100vw, 540px" alt="Illustration générée par IA : air fryer, pommes de terre dorées, minuteur et thermomètre de cuisson" width="1000" height="563" loading="lazy" decoding="async" />
      </div>
    </section>
  </div>
</Base>
<style>.guide-visual{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}.image-note{font-size:.78rem;color:#6a5d54;margin:12px 0}.tool-photo{display:block;width:100%;height:100%;min-height:280px;object-fit:cover}@media(max-width:760px){.tool-photo{height:auto;min-height:0;aspect-ratio:16/9}}</style>
