---
import ProductIllustration from '../../components/ProductIllustration.astro';
import Base from '../../layouts/Base.astro';
import { amazonSearch } from '../../lib/site';

const title = "Accessoires air fryer indispensables : le vrai utile (2026)";
const description = "Les accessoires air fryer qui changent vraiment la donne : papier cuisson perforé, moules silicone, grille étagée, spray à huile, thermomètre… Ce qui sert, ce qui est gadget.";
const papierAnswer = "Cela dépend de ton modèle. Philips déconseille le papier sulfurisé pour les Airfryers couverts par sa fiche d’assistance. Si la notice de ton appareil autorise le papier, pose les aliments dessus avant de démarrer et respecte les consignes sur les dimensions et la température.";

const accessoires = [
  { visual: "paper" as const, emoji: "📄", nom: "Papier cuisson perforé", util: "Peut faciliter le retrait des aliments fragiles sur les modèles qui l’autorisent.", note: "Consulte d’abord la notice de ton modèle. Même perforée, une feuille libre peut être soulevée par le ventilateur.", lien: "papier cuisson perforé air fryer" },
  { emoji: "🧁", nom: "Moules & caissettes en silicone", util: "Pour les muffins, les œufs cocotte et les gratins individuels.", note: "Mesure le fond intérieur du panier, là où le moule sera posé. Compare la largeur, la longueur et la hauteur avec les dimensions extérieures du moule, anses comprises. Laisse de l’espace autour pour que l’air circule et vérifie la température maximale indiquée par le fabricant.", lien: "moule silicone air fryer avec anses", label: "Comparer les moules sur Amazon", image: { src: "/img/guide-moule-silicone-panier.webp", alt: "Moule rectangulaire en silicone avec deux anses posé dans un panier ouvert", caption: "Exemple de placement. Mesure ton panier et compte les anses dans la largeur du moule." } },
  { visual: "rack" as const, emoji: "🍢", nom: "Grille étagée / rack", util: "Ajoute un niveau dans les modèles compatibles ou surélève les aliments.", note: "Vérifie la hauteur disponible une fois la grille en place. Garde de l’espace entre les deux niveaux et contrôle la cuisson sur chacun.", lien: "grille étagée air fryer rack" },
  { visual: "spray" as const, emoji: "💨", nom: "Spray / vaporisateur à huile", util: "Dépose un voile d'huile régulier avec très peu de matière grasse — le geste clé de l'air fryer.", note: "Bien plus économe et homogène qu'un filet d'huile versé. Prends un modèle rechargeable (tu mets ton huile).", lien: "spray huile rechargeable cuisine" },
  { emoji: "🌡️", nom: "Thermomètre à viande", util: "Pour vérifier la température au centre d’un morceau de viande ou de volaille.", note: "Pour un contrôle ponctuel, choisis un modèle à lecture instantanée affichant les degrés Celsius, avec une sonde assez longue pour atteindre le centre de tes morceaux. Mesure dans la partie la plus épaisse sans toucher l’os, puis retire la sonde avant de remettre le panier.", lien: "thermomètre cuisine lecture instantanée sonde", label: "Comparer les thermomètres sur Amazon", image: { src: "/img/guide-thermometre-sonde.webp", alt: "Sonde d’un thermomètre instantané insérée dans un morceau de poulet posé sur une assiette", caption: "Exemple d’utilisation d’une sonde instantanée pour un contrôle ponctuel." } },
  { visual: "sponge" as const, emoji: "🧽", nom: "Brosse / éponge non abrasive", util: "Pour nettoyer le panier sans rayer le revêtement anti-adhésif.", note: "Éviter les éponges métalliques qui abîment la cuve.", lien: "éponge non abrasive nettoyage" },
];

// Le pari malin : le COFFRET complet. Panier moyen plus élevé, et une seule commande
// pour équiper tout son air fryer — peu de sites FR le mettent en avant.
const coffret = { nom: "Coffret d'accessoires air fryer (kit complet)", lien: "coffret accessoires air fryer kit universel" };

const articleSchema = {
  "@context": "https://schema.org", "@type": "Article", "headline": title, "description": description,
  "author": { "@type": "Organization", "name": "L'équipe Airfryer Gourmand", "url": "https://airfryergourmand.fr/a-propos/" },
  "publisher": { "@type": "Organization", "name": "Airfryer Gourmand", "url": "https://airfryergourmand.fr/" },
  "datePublished": "2026-08-01",
};
const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Peut-on mettre du papier cuisson dans un air fryer ?", "acceptedAnswer": { "@type": "Answer", "text": papierAnswer } },
    { "@type": "Question", "name": "Quels accessoires air fryer sont vraiment utiles ?", "acceptedAnswer": { "@type": "Answer", "text": "Un moule aux bonnes dimensions pour les portions individuelles, une sonde pour vérifier la cuisson à cœur et une éponge non abrasive pour l’entretien." } },
  ],
};
---
<Base title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="wrap">
    <article class="article">
      <div class="crumb" style="color:#9a8c7d;font-size:.9rem;margin-bottom:10px">
        <a href="/" style="color:var(--accent);text-decoration:none">Accueil</a> ›
        <a href="/guides/" style="color:var(--accent);text-decoration:none">Guides d'achat</a> › Accessoires
      </div>
      <h1>Accessoires air fryer indispensables (et les gadgets à éviter)</h1>
      <div class="byline" style="display:flex;align-items:center;gap:9px;color:var(--muted);font-size:.9rem;margin:6px 0 16px">
        <span aria-hidden="true">🍟</span>
        <span>Par <a href="/a-propos/" style="color:var(--brand-d);font-weight:700">L'équipe Airfryer Gourmand</a> · Mis à jour le 13 juillet 2026</span>
      </div>
      <div class="quick"><b>En bref.</b> Mesure ton panier pour choisir un moule, prévois une sonde pour contrôler la cuisson à cœur et vérifie la notice avant d’utiliser du papier cuisson.</div>
      <p style="background:var(--cream);border-radius:12px;padding:14px 16px;font-size:.9rem;color:#5f5147">⚖️ <b>Transparence :</b> cette page contient des <b>liens affiliés</b> — si tu achètes via un de nos liens, nous touchons une petite commission, <b>sans surcoût pour toi</b>. Le guide présente les usages de chaque type d’accessoire.</p>

      {accessoires.map((a) => (
        <div class="card-box" style="background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 20px;margin:14px 0;box-shadow:var(--shadow)">
          <div style="font-weight:800;font-size:1.05rem">{a.emoji} {a.nom}</div>
          {a.visual && <ProductIllustration id={a.visual} />}
          {a.image && (
            <figure class="accessory-figure">
              <img src={a.image.src} alt={a.image.alt} width="768" height="512" loading="lazy" decoding="async" />
              <figcaption>{a.image.caption}</figcaption>
            </figure>
          )}
          <p style="margin:6px 0;color:#5f5147"><b>À quoi ça sert :</b> {a.util}</p>
          <p style="margin:6px 0;color:#5f5147"><b>Notre avis :</b> {a.note}</p>
          <a href={amazonSearch(a.lien)} target="_blank" rel="sponsored nofollow noopener" style="display:inline-block;background:#FF9900;color:#111;font-weight:800;text-decoration:none;padding:9px 18px;border-radius:10px;margin-top:6px;font-size:.9rem">{a.label ?? "Voir sur Amazon"} →</a>
        </div>
      ))}

      <div class="card-box" style="background:linear-gradient(135deg,var(--cream),#fff);border:2px solid var(--brand);border-radius:16px;padding:20px 24px;margin:22px 0;box-shadow:var(--shadow)">
        <div style="font-weight:800;color:var(--brand-d);margin-bottom:4px">🎁 Le choix malin : tout en une fois</div>
        <div style="font-weight:700;font-size:1.05rem">{coffret.nom}</div>
        <ProductIllustration id="kit" />
        <p style="margin:6px 0;color:#5f5147">Plutôt que d'acheter chaque accessoire séparément, un <b>coffret universel</b> réunit moules, grille, papier perforé, pince et spray pour le prix de deux ou trois pièces isolées. C'est ce qu'on offrirait à quelqu'un qui vient de recevoir son air fryer. Vérifie juste que le diamètre correspond à ton panier.</p>
        <a href={amazonSearch(coffret.lien)} target="_blank" rel="sponsored nofollow noopener" style="display:inline-block;background:#FF9900;color:#111;font-weight:800;text-decoration:none;padding:11px 20px;border-radius:10px;margin-top:6px">Voir les coffrets sur Amazon →</a>
      </div>

      <div class="card-box" style="background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 24px;margin:24px 0">
        <div style="font-weight:800;color:var(--brand-d);margin-bottom:6px">💬 Le mot de la rédaction</div>
        <p style="color:#5f5147;margin:0">Si tu cuisines souvent des morceaux épais de viande ou de volaille, commence par un <b>thermomètre à viande</b>. Si tu prépares surtout des portions individuelles, mesure d’abord ton panier pour choisir un moule adapté.</p>
      </div>

      <h2 id="mesurer-panier">Mesurer ton panier avant d’acheter un moule</h2>
      <ol>
        <li>À froid, mesure le fond à l’endroit où reposera le moule, puis la largeur à la hauteur des anses.</li>
        <li>Compare ces mesures aux dimensions extérieures du moule. Tiens compte des coins arrondis, de la hauteur utile et du dégagement demandé par la notice.</li>
        <li>Vérifie que tu pourras sortir le moule avec des maniques sans l’incliner. Si le fabricant de l’accessoire donne une liste de modèles compatibles, compare le code complet de l’appareil.</li>
      </ol>
      <h2 id="separateur-panier">Séparer deux aliments dans un panier</h2>
      <p>Un séparateur d’aliments organise l’espace à température commune. Pour le kit HD9950/00, Philips indique notamment les familles HD963X, HD965X, HD975X, HD976X et HD986X. Vérifie ton code dans son catalogue avant l’achat. Sur un FlexDrawer AF500EU, les deux zones disposent de réglages séparés lorsque le séparateur prévu par Ninja est en place. <a href="https://acc.philips.fr/c-e/ho/airfryer-accessories">Compatibilité Philips</a> · <a href="/guides/utiliser-air-fryer/">Régler deux cuissons</a>.</p>
      <h2 id="plaque-rechange">Retrouver la plaque croustillante de rechange</h2>
      <p>Relève le code complet inscrit sur l’appareil. Dans le catalogue du fabricant, distingue la plaque qui repose au fond du tiroir, la grille étagée et le tiroir complet. Sur un appareil à deux paniers, vérifie le côté. Moulinex distingue par exemple une <a href="https://www.moulinex.fr/boutique-accessoires/grille-large-gauche-ss-9100052688/csp/9100052688">grille gauche SS-9100052688</a> et une <a href="https://www.moulinex.fr/boutique-accessoires/grille-droite-ss-9100056098/a/9100056098">grille droite SS-9100056098</a>. Vérifie la liste de compatibilité de la pièce qui correspond à ton code.</p>
      <p><a href="/guides/nettoyer-air-fryer/">Nettoyer le panier et la plaque d’origine</a>.</p>
      <h2>Questions fréquentes</h2>
      <h3 id="papier-cuisson">Peut-on mettre du papier cuisson dans un air fryer ?</h3>
      <p>{papierAnswer} <a href="https://dev.philips.fr/c-f/XC000003625/puis-je-utiliser-du-papier-de-cuisson-aluminium-dans-mon-airfryer-philips">Consulter la liste des références Philips concernées</a>.</p>
      <p>Pendant un préchauffage à vide, laisse le panier libre. Une feuille peut être aspirée vers la résistance. Pour une pâte molle ou une préparation qui coule, utilise un moule autorisé par la notice et adapté aux dimensions du panier.</p>
      <h3>Quels accessoires sont vraiment utiles ?</h3>
      <p>Un moule aux bonnes dimensions pour les portions individuelles, une sonde pour vérifier la cuisson à cœur et une éponge non abrasive pour l’entretien.</p>

      <p style="margin-top:26px"><a class="cta" href="/guides/meilleur-air-fryer-2026/">→ Voir notre comparatif air fryer 2026</a></p>
    </article>
  </div>
</Base>

<style>
  #papier-cuisson, #mesurer-panier, #separateur-panier, #plaque-rechange { scroll-margin-top: 84px; }
  .accessory-figure { max-width: 440px; margin: 12px 0; }
  .accessory-figure img { width: 100%; height: auto; border-radius: 10px; }
  .accessory-figure figcaption { margin-top: 6px; color: var(--muted); font-size: .88rem; }
</style>
