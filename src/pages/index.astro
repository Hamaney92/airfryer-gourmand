---
import Layout from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { SITE, CATEGORIES, catInfo, getPublishedRecipes } from '../lib/site';

const recipes = await getPublishedRecipes();
const latest = recipes.slice(0, 8);

// Compte par catégorie pour les tuiles.
const counts = new Map<string, number>();
for (const r of recipes) {
  const s = catInfo(r.data.category).slug;
  counts.set(s, (counts.get(s) ?? 0) + 1);
}
// Photo représentative par catégorie (WebP 380px générés dans /img/w/).
const TILE_IMG: Record<string, string> = {
  'Volaille': 'poulet-roti-air-fryer',
  'Viande': 'steak-hache-air-fryer',
  'Legume': 'courgette-air-fryer',
  'Poisson': 'saumon-air-fryer',
  'Dessert': 'cookies-air-fryer',
  'Surgelé': 'frites-surgelees-air-fryer',
};
const tiles = ['Volaille', 'Viande', 'Legume', 'Poisson', 'Dessert', 'Surgelé'].map((c) => ({
  ...CATEGORIES[c],
  count: counts.get(CATEGORIES[c].slug) ?? 0,
  img: `/img/w/${TILE_IMG[c]}-380.webp`,
  imgJpg: `/img/${TILE_IMG[c]}.jpg`,
}));

const BOOK_COVER = 'https://m.media-amazon.com/images/P/B0HCSM8ZMD.01._SCLZZZZZZZ_SX500_.jpg';

const title = `${SITE.name} — Recettes & temps de cuisson air fryer`;
const description = SITE.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'fr-FR',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/recettes/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<Layout title={title} description={description} path="/" jsonLd={jsonLd} pageType="homepage">
  <div class="wrap">
    <section class="hero">
      <div>
        <span class="badge">🔥 {recipes.length} recettes publiées</span>
        <h1>Réussissez tout à <span>l'air fryer</span>, du premier coup.</h1>
        <p>Temps de cuisson, températures et astuces pratiques réunis au même endroit. Moins de devinettes, plus de résultats croustillants.</p>
        <div>
          <a href="/recettes/" class="cta">Voir les recettes →</a>
          <a href="/temps-de-cuisson/" class="cta ghost">Temps de cuisson</a>
        </div>
      </div>
      <picture>
        <source type="image/webp" srcset="/img/w/air-fryer-appareil-380.webp 380w, /img/w/air-fryer-appareil-760.webp 760w" sizes="(max-width: 800px) 100vw, 560px" />
        <img src="/img/air-fryer-appareil.jpg" alt="Air fryer sur un plan de travail de cuisine" width="560" height="340" style="height:340px;object-fit:cover;border-radius:20px" fetchpriority="high" decoding="async" />
      </picture>
    </section>

    <div class="trust">
      <span><b>Instructions</b> détaillées</span>
      <span><b>Temps & °C</b> précis</span>
      <span><b>Sans</b> bain d'huile</span>
      <span><b>Maison</b> & surgelés</span>
    </div>

    <section>
      <div class="row">
        <div class="h2">Explorer par catégorie<small>Trouvez la cuisson idéale par type d'aliment</small></div>
        <a href="/recettes/" class="seeall">Tout voir →</a>
      </div>
      <div class="cattiles">
        {tiles.map((t) => (
          <a class="tile" href={`/categorie/${t.slug}/`}>
            <picture>
              <source type="image/webp" srcset={t.img} />
              <img src={t.imgJpg} alt={`Recettes ${t.label} air fryer`} width="380" height="380" loading="lazy" decoding="async" style="width:100%;height:110px;object-fit:cover;display:block" />
            </picture>
            <p>{t.label}<br /><span style="color:var(--muted);font-weight:600">{t.count} recettes</span></p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="row">
        <div class="h2">Dernières recettes<small>Les nouvelles recettes publiées sur le site</small></div>
        <a href="/recettes/" class="seeall">Tout voir →</a>
      </div>
      <div class="cards">
        {latest.map((r, i) => <RecipeCard recipe={r} eager={i < 4} />)}
      </div>
    </section>

    <section>
      <div class="tool">
        <div class="txt">
          <h3>Convertisseur four → air fryer</h3>
          <p>Une recette pensée pour le four ? Obtenez la température et le temps ajustés pour l'air fryer en un clic, plus le tableau des temps par aliment.</p>
          <a href="/temps-de-cuisson/" class="cta">Ouvrir l'outil →</a>
        </div>
        <img src="/img/outil-convertisseur.jpg" alt="Air fryer posé sur un plan de travail à côté d'un vieux carnet de recettes et d'un minuteur" width="1400" height="933" loading="lazy" decoding="async" class="toolimg" />
      </div>
    </section>

    <section>
      <div class="book-home">
        <img src={BOOK_COVER} alt="Couverture du livre Air Fryer gourmand pour seniors" width="180" height="225" loading="lazy" decoding="async" />
        <div>
          <span class="badge">Notre livre</span>
          <h2>100 recettes pour 1 ou 2 personnes</h2>
          <p>Des quantités justes, des étapes courtes et les temps de cuisson précis, dans une mise en page facile à lire.</p>
          <a href="/livre/" class="cta" data-book-entry data-placement="homepage" data-page-type="homepage">Découvrir le livre →</a>
        </div>
      </div>
    </section>

    <section>
      <div class="author">
        <div class="avatar">AG</div>
        <p><b>Chaque recette va droit au but.</b> Vous retrouvez le temps, la température, les étapes, les pièges à éviter et les variantes utiles au même endroit.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .book-home{display:grid;grid-template-columns:180px 1fr;gap:30px;align-items:center;background:linear-gradient(135deg,#fff3e7,#fffaf5);border:1px solid #ffd6b8;border-radius:22px;padding:28px 34px}
  .book-home img{width:180px;height:auto;border-radius:7px;box-shadow:0 12px 30px rgba(70,42,22,.2)}
  .book-home h2{font-size:1.7rem;line-height:1.15;margin-bottom:8px}
  .book-home p{color:var(--muted);margin-bottom:17px;max-width:620px}
  @media(max-width:620px){
    .book-home{grid-template-columns:1fr;text-align:center;padding:24px 20px}
    .book-home img{width:145px;margin:0 auto}
  }
</style>
