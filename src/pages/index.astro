---
import Layout from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import MealSearch from '../components/MealSearch.astro';
import SeasonalSpotlight from '../components/SeasonalSpotlight.astro';
import ChristmasTheme from '../components/ChristmasTheme.astro';
import NewsletterBanner from '../components/NewsletterBanner.astro';
import { SITE, CATEGORIES, catInfo, getPublishedRecipes, totalTime } from '../lib/site';

const recipes = await getPublishedRecipes();
const feta = recipes.find(recipe => recipe.id === 'feta-rotie-air-fryer');
const latest = recipes.slice(0, 8);

// Compte par catégorie pour les tuiles.
const counts = new Map<string, number>();
for (const r of recipes) {
  const s = catInfo(r.data.category).slug;
  counts.set(s, (counts.get(s) ?? 0) + 1);
}
// Photo représentative par catégorie (WebP 380px générés dans /img/w/).
const TILE_IMG: Record<string, string> = {
  'Volaille': 'poulet-roti-air-fryer',
  'Viande': 'steak-hache-air-fryer',
  'Legume': 'courgette-air-fryer',
  'Poisson': 'saumon-air-fryer',
  'Dessert': 'cookies-air-fryer',
  'Surgelé': 'frites-surgelees-air-fryer',
};
const tiles = ['Volaille', 'Viande', 'Legume', 'Poisson', 'Dessert', 'Surgelé'].map((c) => ({
  ...CATEGORIES[c],
  count: counts.get(CATEGORIES[c].slug) ?? 0,
  img: `/img/w/${TILE_IMG[c]}-380.webp`,
  imgJpg: `/img/${TILE_IMG[c]}.jpg`,
}));

const BOOK_COVER = '/img/books/air-fryer-anti-gaspi-360.webp';

const title = `${SITE.name} — Recettes & temps de cuisson air fryer`;
const description = `${recipes.length} recettes à l’air fryer avec temps et températures, un convertisseur four → air fryer et un tableau de cuisson PDF gratuit.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'fr-FR',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/recherche/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<Layout title={title} description={description} path="/" jsonLd={jsonLd} pageType="homepage">
  <div class="wrap">
    <section class="hero">
      <div class="hero-content">
        <h1>Qu’est-ce qu’on cuisine <span>à l’air fryer ce soir&nbsp;?</span></h1>
        <p class="hero-intro">Partez de ce que vous avez au frigo. Choisissez une recette, puis ajoutez-la à votre menu.</p>
        <a class="resume-menu" href="/recherche/#menu-reprise" id="resume-menu" hidden>Reprendre mon menu enregistré →</a>
        <MealSearch home />
      </div>
      <figure class="hero-dish">
        <a href="/recettes/feta-rotie-air-fryer/" aria-label="Découvrir la recette de feta rôtie à l’air fryer">
          <picture>
            <source type="image/webp" srcset="/img/w/feta-rotie-air-fryer-380.webp 380w, /img/w/feta-rotie-air-fryer-760.webp 760w" sizes="(max-width: 860px) calc(100vw - 40px), 510px" />
            <img src="/img/feta-rotie-air-fryer.jpg" alt="Feta dorée, tomates rôties et olives dans un plat" width="760" height="760" fetchpriority="high" decoding="async" />
          </picture>
        </a>
        <figcaption><span>À partager{feta && totalTime(feta) > 0 && ` · ${totalTime(feta)} min`}</span><a href="/recettes/feta-rotie-air-fryer/">Feta rôtie à l’air fryer <span aria-hidden="true">↗</span></a></figcaption>
      </figure>
    </section>

  </div>
  <ChristmasTheme />
  <div class="wrap">
    <nav class="kitchen-tools" aria-label="Organiser ses repas et ses cuissons">
      <a href="/batch-cooking/" id="home-menu-link">
        <strong id="home-menu-label">Préparer ma semaine</strong>
        <span id="home-menu-detail">Composer un menu et sa liste de courses</span>
      </a>
      <a href="/tableau-temps-cuisson-air-fryer/"><strong>Vérifier une cuisson</strong><span>Temps et température par aliment</span></a>
      <a href="/temps-de-cuisson/"><strong>Adapter une recette au four</strong><span>Convertir les degrés et les minutes pour l’air fryer</span></a>
    </nav>

    <SeasonalSpotlight />

    <section>
      <div class="row">
        <h2 class="h2">Explorer par catégorie<small>Trouvez la cuisson idéale par type d'aliment</small></h2>
        <a href="/recettes/" class="seeall">Tout voir →</a>
      </div>
      <div class="cattiles">
        {tiles.map((t) => (
          <a class="tile" href={`/categorie/${t.slug}/`}>
            <picture>
              <source type="image/webp" srcset={t.img} />
              <img src={t.imgJpg} alt={`Recettes ${t.label} air fryer`} width="380" height="380" loading="lazy" decoding="async" style="width:100%;height:110px;object-fit:cover;display:block" />
            </picture>
            <p>{t.label}<br /><span style="color:var(--muted);font-weight:600">{t.count} recettes</span></p>
          </a>
        ))}
      </div>
    </section>

  </div>
  <NewsletterBanner pageType="homepage" />
  <div class="wrap">
    <section aria-labelledby="dernieres-recettes">
      <div class="row">
        <h2 class="h2" id="dernieres-recettes">Dernières recettes<small>Les nouvelles recettes publiées sur le site</small></h2>
        <a href="/recettes/" class="seeall">Tout voir →</a>
      </div>
      <div class="cards">
        {latest.map((r, i) => <RecipeCard recipe={r} eager={i < 4} />)}
      </div>
    </section>

    <section>
      <div class="tool">
        <div class="txt">
          <h3>Convertisseur four → air fryer</h3>
          <p>Une recette pensée pour le four ? Ajustez sa température et son temps de cuisson pour l’air fryer.</p>
          <a href="/temps-de-cuisson/" class="cta">Ouvrir l'outil →</a>
          <p><a class="tool-table-link" href="/tableau-temps-cuisson-air-fryer/">Voir le tableau par aliment et son PDF gratuit →</a></p>
        </div>
        <img src="/img/outil-convertisseur.jpg" alt="Air fryer posé sur un plan de travail à côté d'un vieux carnet de recettes et d'un minuteur" width="1400" height="933" loading="lazy" decoding="async" class="toolimg" />
      </div>
    </section>

    <section>
      <div class="guide-home">
        <div>
          <span class="badge">Guide pratique</span>
          <h2>Réchauffer les restes au air fryer sans les dessécher</h2>
          <p>Temps indicatifs, méthode et règles de sécurité : gardez le croustillant et évitez le gaspillage alimentaire.</p>
          <a href="/dossiers/rechauffer-restes-air-fryer/" class="cta">Voir le guide anti-gaspi →</a>
          <p style="margin:18px 0 0">À cuisiner en ce moment : <a href="/dossiers/recettes-air-fryer-automne/" style="font-weight:750;text-decoration:underline;text-underline-offset:3px">nos recettes d’automne à l’air fryer</a>.</p>
        </div>
      </div>
    </section>

    <section>
      <div class="book-home">
        <img src={BOOK_COVER} alt="Couverture du livre Air Fryer Anti-Gaspi" width="180" height="225" loading="lazy" decoding="async" />
        <div>
          <span class="badge">Notre livre</span>
          <h2>Air Fryer Anti-Gaspi</h2>
          <p>100 recettes pour transformer le pain rassis, le riz, les légumes et d’autres restes en nouveaux plats.</p>
          <a href="/livres/air-fryer-anti-gaspi/" class="cta" data-book-entry data-placement="homepage_anti_gaspi" data-page-type="homepage">Feuilleter le livre →</a>
        </div>
      </div>
    </section>

    <section>
      <div class="author">
        <div class="avatar">AG</div>
        <p><b>Chaque recette va droit au but.</b> Vous retrouvez le temps, la température, les étapes, les pièges à éviter et les variantes utiles au même endroit.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero-content{min-width:0}
  .hero .hero-intro{font-size:1.03rem;line-height:1.5;margin-bottom:18px}
  #dernieres-recettes{scroll-margin-top:80px}
  .tool-table-link{display:inline-block;margin-top:12px;color:var(--brand-d);font-weight:700;text-decoration:underline;text-underline-offset:4px}
  .hero-dish{min-width:0;margin:0}
  .hero-dish>a{display:block;border-radius:18px;overflow:hidden}
  .hero-dish img{width:100%;height:auto;aspect-ratio:1;object-fit:cover}
  .hero-dish figcaption{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line);font-size:.85rem}
  .hero-dish figcaption>span{color:var(--muted)}
  .hero-dish figcaption a{color:var(--brand-d);font-weight:700;text-decoration:underline;text-underline-offset:4px}
  .guide-home{background:#f2f5ee;border-left:4px solid #34523f;border-radius:0 14px 14px 0;padding:28px 32px}
  .guide-home h2{font-family:Georgia,serif;font-weight:500;font-size:1.8rem;line-height:1.2;margin:7px 0 12px;max-width:650px}
  .guide-home p{color:var(--muted);margin-bottom:17px;max-width:660px}
  .book-home{display:grid;grid-template-columns:180px 1fr;gap:30px;align-items:center;background:var(--cream);border:1px solid var(--line);border-radius:18px;padding:32px 34px}
  .book-home img{width:180px;height:auto;border-radius:7px;box-shadow:0 12px 30px rgba(70,42,22,.2)}
  .book-home h2{font-family:Georgia,serif;font-weight:500;font-size:1.95rem;line-height:1.2;margin-bottom:12px}
  .book-home p{color:var(--muted);margin-bottom:17px;max-width:620px}
  @media(max-width:620px){
    .hero{padding-top:24px;gap:20px}
    .hero-dish figcaption{align-items:flex-start;flex-direction:column;gap:5px}
    .guide-home{padding:24px 20px}
    .book-home{grid-template-columns:1fr;text-align:center;padding:24px 20px}
    .book-home img{width:145px;margin:0 auto}
  }
</style>


<style>
  .resume-menu:not([hidden]) {display:inline-flex;align-items:center;min-height:44px;font-weight:700;color:#174b38;text-decoration:underline;text-underline-offset:4px}
  .hero {column-gap:clamp(2rem,5vw,5rem)}
  .hero h1 {font-size:clamp(2.6rem,5vw,4.2rem);line-height:1.02;letter-spacing:-.045em;color:#173d31}
  .hero h1 span {display:block;color:#934226;font-style:italic}
  .hero-dish>a {border-radius:clamp(24px,4vw,58px) 12px 12px 12px}
  .hero-dish img {aspect-ratio:5/4}
  .kitchen-tools {display:grid;grid-template-columns:repeat(3,1fr);background:#153f32;color:#fffaf1;border-radius:20px;margin:12px 0 36px;padding:12px}
  .kitchen-tools a {position:relative;padding:16px 36px 16px 18px;border-radius:12px}
  .kitchen-tools a+a {border-left:1px solid #527265}
  .kitchen-tools strong,.kitchen-tools span {display:block}
  .kitchen-tools strong {font:500 1.38rem/1.22 Georgia,serif}
  .kitchen-tools span {margin-top:6px;color:#e2eadf;font-size:.9rem;line-height:1.45}
  .kitchen-tools a::after {content:'→';position:absolute;right:12px;top:16px;color:#e4ecad}
  .kitchen-tools a:hover {background:#245441}
  .kitchen-tools a:focus-visible {outline:3px solid #e4ecad;outline-offset:0}
  @media(max-width:740px){
    .kitchen-tools {grid-template-columns:1fr;padding:8px}
    .kitchen-tools a+a {border-left:0;border-top:1px solid #527265}
  }
</style>
<script>
  import { MENU_STORAGE_KEY, readSavedMenu } from '../lib/meal-menu-storage.mjs';

  const link = document.querySelector<HTMLAnchorElement>('#home-menu-link')!;
  const label = document.querySelector('#home-menu-label')!;
  const detail = document.querySelector('#home-menu-detail')!;
  const original = {href: link.getAttribute('href')!, label: label.textContent, detail: detail.textContent};
  const resume = document.querySelector<HTMLElement>("#resume-menu")!;
  let revision = 0;
  async function refreshMenu() {
    const current = ++revision;
    resume.hidden = true;
    link.setAttribute('href', original.href);
    label.textContent = original.label;
    detail.textContent = original.detail;
    try {
      const raw = localStorage.getItem(MENU_STORAGE_KEY);
      if (!raw) return;
      const response = await fetch('/recherche/catalogue.json');
      if (!response.ok || current !== revision) return;
      const catalog = await response.json();
      const saved = readSavedMenu(raw, catalog);
      if (current !== revision || saved.status !== 'ready' || !saved.menu) return;
      const {ids, people} = saved.menu;
      resume.hidden = false;
      link.href = '/recherche/#menu-reprise';
      label.textContent = 'Retrouver mon menu';
      detail.textContent = ids.length + (ids.length > 1 ? ' recettes' : ' recette') + ' · ' + people + (people > 1 ? ' personnes' : ' personne');
    } catch { /* Le parcours pour composer un menu reste accessible. */ }
  }
  window.addEventListener('pageshow', refreshMenu);
  window.addEventListener('storage', event => {
    if (event.key === MENU_STORAGE_KEY || event.key === null) refreshMenu();
  });
</script>
