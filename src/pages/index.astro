---
import Layout from '../layouts/Layout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { SITE, CATEGORIES, catInfo, getPublishedRecipes } from '../lib/site';

const recipes = await getPublishedRecipes();
const latest = recipes.slice(0, 8);

// Compte par catégorie pour les tuiles.
const counts = new Map<string, number>();
for (const r of recipes) {
  const s = catInfo(r.data.category).slug;
  counts.set(s, (counts.get(s) ?? 0) + 1);
}
// Photo représentative par catégorie (WebP 380px générés dans /img/w/).
const TILE_IMG: Record<string, string> = {
  'Volaille': 'poulet-roti-air-fryer',
  'Viande': 'steak-hache-air-fryer',
  'Legume': 'courgette-air-fryer',
  'Poisson': 'saumon-air-fryer',
  'Dessert': 'cookies-air-fryer',
  'Surgelé': 'frites-surgelees-air-fryer',
};
const tiles = ['Volaille', 'Viande', 'Legume', 'Poisson', 'Dessert', 'Surgelé'].map((c) => ({
  ...CATEGORIES[c],
  count: counts.get(CATEGORIES[c].slug) ?? 0,
  img: `/img/w/${TILE_IMG[c]}-380.webp`,
  imgJpg: `/img/${TILE_IMG[c]}.jpg`,
}));

const BOOK_COVER = 'https://m.media-amazon.com/images/P/B0HCSM8ZMD.01._SCLZZZZZZZ_SX500_.jpg';

const title = `${SITE.name} — Recettes & temps de cuisson air fryer`;
const description = SITE.description;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'fr-FR',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/recettes/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<Layout title={title} description={description} path="/" jsonLd={jsonLd} pageType="homepage">
  <div class="wrap">
    <section class="hero">
      <div>
        <span class="badge">🔥 {recipes.length} recettes publiées</span>
        <h1>Réussissez tout à <span>l'air fryer</span>, du premier coup.</h1>
        <p>Temps de cuisson, températures et astuces pratiques réunis au même endroit. Moins de devinettes, plus de résultats croustillants.</p>
        <div>
          <a href="/recettes/" class="cta">Voir les recettes →</a>
          <a href="/temps-de-cuisson/" class="cta ghost">Temps de cuisson</a>
        </div>
        <form action="/recettes/" method="get" role="search" aria-label="Trouver une recette" style="margin-top:20px;display:flex;gap:8px;flex-wrap:wrap">
          <label for="home-recipe-search" style="width:100%;font-size:.9rem;font-weight:700">Qu’avez-vous envie de cuisiner ?</label>
          <input id="home-recipe-search" name="q" type="search" placeholder="Un ingrédient : poulet, courgette…" style="min-width:0;flex:1 1 220px;padding:12px;border:1px solid #bba99b;border-radius:10px;font:inherit" />
          <button type="submit" class="cta" style="padding:12px 16px">Rechercher</button>
        </form>
      </div>
      <figure class="hero-dish">
        <a href="/recettes/feta-rotie-air-fryer/" aria-label="Découvrir la recette de feta rôtie au air fryer">
          <picture>
            <source type="image/webp" srcset="/img/w/feta-rotie-air-fryer-380.webp 380w, /img/w/feta-rotie-air-fryer-760.webp 760w" sizes="(max-width: 860px) calc(100vw - 40px), 510px" />
            <img src="/img/feta-rotie-air-fryer.jpg" alt="Feta dorée, tomates rôties et olives dans un plat" width="760" height="760" fetchpriority="high" decoding="async" />
          </picture>
        </a>
        <figcaption><span>À partager</span><a href="/recettes/feta-rotie-air-fryer/">Feta rôtie au air fryer <span aria-hidden="true">↗</span></a></figcaption>
      </figure>
    </section>

    <section aria-labelledby="christmas-guides-title" style="padding:22px;border:1px solid var(--line);border-radius:18px;background:var(--card);margin-top:24px">
      <h2 id="christmas-guides-title">Préparer Noël, sans tout acheter ni tout cuire à la fois</h2>
      <p>Choisis un menu adapté à ton panier ou un cadeau qui répond à une vraie habitude de cuisine.</p>
      <p><a class="cta" href="/dossiers/menu-noel-air-fryer/">Préparer mon menu de Noël →</a></p>
      <p><a href="/guides/cadeaux-cuisine-noel/">Comparer 8 idées de cadeaux cuisine →</a></p>
    </section>

    <div class="trust">
      <span><b>Instructions</b> détaillées</span>
      <span><b>Temps & °C</b> précis</span>
      <span><b>Sans</b> bain d'huile</span>
      <span><b>Maison</b> & surgelés</span>
    </div>

    <section>
      <div class="row">
        <h2 class="h2">Explorer par catégorie<small>Trouvez la cuisson idéale par type d'aliment</small></h2>
        <a href="/recettes/" class="seeall">Tout voir →</a>
      </div>
      <div class="cattiles">
        {tiles.map((t) => (
          <a class="tile" href={`/categorie/${t.slug}/`}>
            <picture>
              <source type="image/webp" srcset={t.img} />
              <img src={t.imgJpg} alt={`Recettes ${t.label} air fryer`} width="380" height="380" loading="lazy" decoding="async" style="width:100%;height:110px;object-fit:cover;display:block" />
            </picture>
            <p>{t.label}<br /><span style="color:var(--muted);font-weight:600">{t.count} recettes</span></p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="row">
        <h2 class="h2">Dernières recettes<small>Les nouvelles recettes publiées sur le site</small></h2>
        <a href="/recettes/" class="seeall">Tout voir →</a>
      </div>
      <div class="cards">
        {latest.map((r, i) => <RecipeCard recipe={r} eager={i < 4} />)}
      </div>
    </section>

    <section>
      <div class="tool">
        <div class="txt">
          <h3>Convertisseur four → air fryer</h3>
          <p>Une recette pensée pour le four ? Obtenez la température et le temps ajustés pour l'air fryer en un clic, plus le tableau des temps par aliment.</p>
          <a href="/temps-de-cuisson/" class="cta">Ouvrir l'outil →</a>
        </div>
        <img src="/img/outil-convertisseur.jpg" alt="Air fryer posé sur un plan de travail à côté d'un vieux carnet de recettes et d'un minuteur" width="1400" height="933" loading="lazy" decoding="async" class="toolimg" />
      </div>
    </section>

    <section>
      <div class="guide-home">
        <div>
          <span class="badge">Guide pratique</span>
          <h2>Réchauffer les restes au air fryer sans les dessécher</h2>
          <p>Temps indicatifs, méthode et règles de sécurité : gardez le croustillant et évitez le gaspillage alimentaire.</p>
          <a href="/dossiers/rechauffer-restes-air-fryer/" class="cta">Voir le guide anti-gaspi →</a>
          <p style="margin:18px 0 0">À cuisiner en ce moment : <a href="/dossiers/recettes-air-fryer-automne/" style="font-weight:750;text-decoration:underline;text-underline-offset:3px">nos recettes d’automne à l’air fryer</a>.</p>
        </div>
      </div>
    </section>

    <section>
      <div class="book-home">
        <img src={BOOK_COVER} alt="Couverture du livre Air Fryer gourmand pour seniors" width="180" height="225" loading="lazy" decoding="async" />
        <div>
          <span class="badge">Notre livre</span>
          <h2>100 recettes pour 1 ou 2 personnes</h2>
          <p>Des quantités justes, des étapes courtes et les temps de cuisson précis, dans une mise en page facile à lire.</p>
          <a href="/livre/" class="cta" data-book-entry data-placement="homepage" data-page-type="homepage">Découvrir le livre →</a>
          <a href="/livres/air-fryer-anti-gaspi/" class="new-book-link" data-book-entry data-placement="homepage_anti_gaspi" data-page-type="homepage">Nouveau : 100 recettes anti-gaspi →</a>
        </div>
      </div>
    </section>

    <section>
      <div class="author">
        <div class="avatar">AG</div>
        <p><b>Chaque recette va droit au but.</b> Vous retrouvez le temps, la température, les étapes, les pièges à éviter et les variantes utiles au même endroit.</p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero-dish{min-width:0;margin:0}
  .hero-dish>a{display:block;border-radius:18px;overflow:hidden}
  .hero-dish img{width:100%;height:auto;aspect-ratio:1;object-fit:cover}
  .hero-dish figcaption{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line);font-size:.85rem}
  .hero-dish figcaption>span{color:var(--muted)}
  .hero-dish figcaption a{color:var(--brand-d);font-weight:700;text-decoration:underline;text-underline-offset:4px}
  .guide-home{background:#f2f5ee;border-left:4px solid #34523f;border-radius:0 14px 14px 0;padding:28px 32px}
  .guide-home h2{font-family:Georgia,serif;font-weight:500;font-size:1.8rem;line-height:1.2;margin:7px 0 12px;max-width:650px}
  .guide-home p{color:var(--muted);margin-bottom:17px;max-width:660px}
  .book-home{display:grid;grid-template-columns:180px 1fr;gap:30px;align-items:center;background:var(--cream);border:1px solid var(--line);border-radius:18px;padding:32px 34px}
  .book-home img{width:180px;height:auto;border-radius:7px;box-shadow:0 12px 30px rgba(70,42,22,.2)}
  .book-home h2{font-family:Georgia,serif;font-weight:500;font-size:1.95rem;line-height:1.2;margin-bottom:12px}
  .book-home p{color:var(--muted);margin-bottom:17px;max-width:620px}
  .new-book-link{display:inline-block;margin-left:14px;font-weight:800;color:#173e32;text-underline-offset:3px}
  @media(max-width:620px){
    .hero-dish figcaption{align-items:flex-start;flex-direction:column;gap:5px}
    .guide-home{padding:24px 20px}
    .book-home{grid-template-columns:1fr;text-align:center;padding:24px 20px}
    .book-home img{width:145px;margin:0 auto}
    .new-book-link{display:block;margin:14px 0 0}
  }
</style>
