---
import Layout from '../layouts/Layout.astro';
import BookPreview from '../components/BookPreview.astro';
import { SITE, amazonProduct } from '../lib/site';
const books = [
  {id:'petites-portions',asin:'B0HCSM8ZMD',name:'Air Fryer gourmand pour seniors',label:'Pour 1 ou 2 personnes',hook:'Bien cuisiner, juste pour vous.',cover:'https://m.media-amazon.com/images/P/B0HCSM8ZMD.01._SCLZZZZZZZ_SX500_.jpg',description:'Les bonnes quantités, sans calcul. 100 recettes pour les repas en solo ou à deux, avec des étapes courtes et une lecture confortable.',features:['100 recettes pour une ou deux portions','Grands caractères et présentation aérée','Temps et températures à chaque recette'],pages:224},
  {id:'anti-gaspi',asin:'B0HHZM8TYR',name:'Air Fryer Anti-Gaspi',label:'Pour une cuisine anti-gaspi',hook:'De beaux repas avec les restes.',cover:'/img/books/air-fryer-anti-gaspi.png',description:'Du pain de la veille, un reste de riz, des légumes à utiliser : 100 recettes pour leur donner une nouvelle place dans votre assiette.',features:['100 recettes classées par reste disponible','Quantités, température et durée','Alternatives et conseils de conservation'],pages:114},
];
const faq = [
  {q:'Quel livre choisir pour cuisiner seul ou à deux ?',a:'Air Fryer gourmand pour seniors propose 100 recettes prévues pour une ou deux portions. Les grands caractères et les étapes courtes conviennent à tout âge.'},
  {q:'Quel livre choisir pour utiliser les restes ?',a:'Air Fryer Anti-Gaspi propose 100 recettes organisées selon les ingrédients à utiliser : pain, riz, pâtes, légumes, protéines cuites, conserves et fruits mûrs. Il ne sert pas seulement à réchauffer : les restes deviennent de nouveaux plats.'},
  {q:'Faut-il un modèle particulier d’air fryer ?',a:'Les recettes conviennent aux principaux appareils à panier. Ajustez si nécessaire la cuisson selon la puissance, la taille et le remplissage de votre appareil.'},
  {q:'Où consulter le prix et commander les livres ?',a:'Chaque bouton « Voir sur Amazon » ouvre la fiche du livre correspondant. Le prix, les formats et la disponibilité sont à vérifier directement sur Amazon.'},
];
const jsonLd = [
  {'@context':'https://schema.org','@type':'CollectionPage',name:'Nos livres Air Fryer',url:`${SITE.url}/livre/`,mainEntity:{'@type':'ItemList',itemListElement:books.map((book,i)=>({'@type':'ListItem',position:i+1,item:{'@type':'Book',name:book.name,author:{'@type':'Person',name:'Camille Lefèvre'},inLanguage:'fr',bookFormat:'https://schema.org/Paperback',numberOfPages:book.pages,image:new URL(book.cover,SITE.url).href,url:`${SITE.url}/livre/#${book.id}`,sameAs:`https://www.amazon.fr/dp/${book.asin}`}}))}},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Accueil',item:SITE.url},{'@type':'ListItem',position:2,name:'Nos livres',item:`${SITE.url}/livre/`}]},
  {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))},
];
---
<Layout title="Nos livres Air Fryer : petites portions & anti-gaspi | Airfryer Gourmand" description="Découvrez nos deux livres Air Fryer : 100 recettes pour 1 ou 2 personnes et 100 recettes anti-gaspi pour transformer les restes." path="/livre/" image={books[0].cover} jsonLd={jsonLd} pageType="book">
  <div class="library"><div class="wrap">
    <nav class="library-crumb" aria-label="Fil d’Ariane"><a href="/">Accueil</a> / Nos livres</nav>
    <section class="library-intro" aria-labelledby="library-title">
      <div><p class="eyebrow">La collection Airfryer Gourmand</p><h1 id="library-title">Nos livres.<br /><em>Votre prochaine idée cuisine.</em></h1><p class="intro-text">Deux livres de Camille Lefèvre, deux façons de cuisiner au quotidien : préparer les bonnes portions ou transformer les restes.</p><a class="collection-link" href="#collection">Trouver mon livre <span aria-hidden="true">↓</span></a></div>
      <div class="library-note"><span>02</span><p>livres à garder<br />près du plan de travail</p></div>
    </section>
    <nav class="book-choices" aria-label="Choisir selon votre besoin"><a href="#petites-portions">Je cuisine pour 1 ou 2 →</a><a href="#anti-gaspi">Je veux utiliser mes restes →</a><a href="#apercu-petites-portions">Feuilleter le livre petites portions ↓</a></nav>
    <section id="collection" class="collection" aria-label="Les deux livres de la collection">
      {books.map((book,i)=>(
        <article id={book.id} class:list={['book-tile',{green:i===1}]} aria-labelledby={`${book.id}-title`}>
          <div class="book-stage"><span class="volume">La collection / 0{i+1}</span><a class="cover-link" href={i===0?'#petites-portions-details':'/livres/air-fryer-anti-gaspi/'} aria-label={`Découvrir ${book.name}`} data-book-entry data-book-id={book.id} data-placement="collection_cover"><img src={book.cover} alt={`Couverture : ${book.name}, par Camille Lefèvre`} width="300" height="390" decoding="async" /></a><span class="stage-caption">100 recettes · {book.pages} pages</span></div>
          <div class="book-info" id={i===0?'petites-portions-details':undefined}><p class="book-label">{book.label}</p><h2 id={`${book.id}-title`}>{book.name}</h2><p class="book-hook">{book.hook}</p><p class="book-description">{book.description}</p><ul>{book.features.map(feature=><li>{feature}</li>)}</ul><div class="book-actions"><a class="buy-link" href={amazonProduct(book.asin)} target="_blank" rel="sponsored nofollow noopener" data-affiliate-network="amazon" data-product-name={book.name} data-product-asin={book.asin} data-product-type="book" data-page-type="book" data-page-id="/livre/" data-placement="collection_card">Voir sur Amazon <span aria-hidden="true">↗</span></a>{i===1&&<a class="detail-link" href="/livres/air-fryer-anti-gaspi/" data-book-entry data-book-id={book.id} data-placement="collection_details">En savoir plus →</a>}</div></div>
        </article>
      ))}
    </section>
    <p class="commercial-note">Ce sont nos livres. Les liens Amazon sont affiliés : une commission peut nous être versée, sans surcoût pour vous. Prix et disponibilité à vérifier sur Amazon.</p>
    <BookPreview />
    <p class="preview-buy"><a class="buy-link" href={amazonProduct(books[0].asin)} target="_blank" rel="sponsored nofollow noopener" data-affiliate-network="amazon" data-product-name={books[0].name} data-product-asin={books[0].asin} data-product-type="book" data-page-type="book" data-placement="after_book_preview">Voir le prix et commander sur Amazon ↗</a></p>
    <section class="library-faq" aria-labelledby="faq-title"><div><p class="eyebrow">Avant de choisir</p><h2 id="faq-title">Un livre qui correspond<br />à votre cuisine.</h2><p>Petites portions ou ingrédients à sauver : partez de vos habitudes.</p></div><div>{faq.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
    <div class="free-invitation"><p>Envie de cuisiner tout de suite ?</p><a href="/recettes/">Retrouver nos recettes gratuites →</a></div>
  </div></div>
</Layout>
<style>
  .book-choices{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 24px}.book-choices a{padding:12px 16px;border:1px solid #b1bdac;border-radius:9px;background:#fff;font-size:.88rem;font-weight:700}.preview-buy{margin:0 0 24px}
  .library{background:#faf7f0;padding:24px 0 64px;color:#263a30}.library-crumb{font-size:.8rem;color:#6d736b}.library-crumb a{color:inherit}
  .library-intro{display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;padding:58px 0 48px}.eyebrow{font-size:.72rem;text-transform:uppercase;letter-spacing:.14em;font-weight:800;color:#7b5939;margin:0 0 16px}
  .library-intro h1{font-family:Georgia,serif;font-size:clamp(2.5rem,4.8vw,4.4rem);line-height:1.08;font-weight:500;letter-spacing:-.045em;margin:0 0 24px;max-width:810px}.library-intro h1 em{color:#a44c2d;font-weight:400}.intro-text{color:#5c675d;font-size:1.05rem;line-height:1.75;max-width:620px}.collection-link{display:inline-flex;align-items:center;gap:24px;color:#263a30;font-weight:750;margin-top:8px;padding:12px 0;border-bottom:1px solid #263a30}
  .library-note{text-align:center;border-left:1px solid #d7d9cc;padding:10px 0 10px 40px;color:#647263}.library-note>span{font-family:Georgia,serif;font-size:5.5rem;line-height:1;color:#34523f}.library-note p{font-size:.8rem;line-height:1.6;margin:10px 0}
  .collection{display:grid;grid-template-columns:1fr 1fr;gap:28px;scroll-margin-top:90px}.book-tile{border:1px solid #deddd0;border-radius:20px;overflow:hidden;background:#fff;display:flex;flex-direction:column;scroll-margin-top:90px}
  .book-stage{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:420px;padding:48px 26px 24px;background:radial-gradient(ellipse at 50% 40%,#fff8e8,#eddfc5)}.green .book-stage{background:radial-gradient(ellipse at 50% 40%,#4e7860,#173e32);color:#fff}.volume{position:absolute;top:20px;left:24px;text-transform:uppercase;letter-spacing:.13em;font-size:.65rem;font-weight:750}.cover-link{display:block;transform:rotate(-4deg);transition:transform .3s ease}.green .cover-link{transform:rotate(4deg)}.cover-link img{display:block;width:220px;height:286px;object-fit:contain;filter:drop-shadow(12px 16px 12px #13291d45)}.stage-caption{margin-top:28px;font-size:.76rem;letter-spacing:.05em}
  .book-info{padding:30px;display:flex;flex-direction:column;flex:1;scroll-margin-top:90px}.book-label{color:#956039;text-transform:uppercase;font-size:.67rem;font-weight:850;letter-spacing:.1em;margin:0 0 10px}.book-info h2{font-family:Georgia,serif;font-size:1.8rem;line-height:1.15;margin:0 0 12px;color:#263a30;letter-spacing:-.03em}.book-hook{font-weight:750;font-size:1rem;margin:0 0 10px}.book-description{color:#606a60;font-size:.94rem;line-height:1.75;margin:0 0 18px}.book-info ul{list-style:none;padding:0;margin:0 0 26px;display:grid;gap:9px;font-size:.85rem;color:#455a49}.book-info li{padding-left:22px;position:relative}.book-info li::before{content:'✓';position:absolute;left:0;color:#426b47}
  .book-actions{display:flex;align-items:center;flex-wrap:wrap;gap:16px;margin-top:auto}.buy-link{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;background:#234b36;color:#fff;border-radius:8px;padding:14px 20px;min-height:48px;font-weight:750;font-size:.88rem;transition:background .2s}.buy-link:hover{background:#326747}.detail-link{color:#34523f;font-size:.84rem;font-weight:750;padding:12px 0;text-decoration:underline;text-underline-offset:4px}.commercial-note{font-size:.74rem;color:#6d736b;line-height:1.7;text-align:center;max-width:820px;margin:22px auto 0}
  .library-faq{display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;padding:66px 0;border-bottom:1px solid #d7d9cc}.library-faq h2{font-family:Georgia,serif;font-size:2rem;line-height:1.2;font-weight:500;margin:0 0 16px}.library-faq>div>p:not(.eyebrow){font-size:.92rem;color:#606a60;max-width:330px;line-height:1.7}details{border-bottom:1px solid #d7d9cc;padding:0 0 18px;margin-bottom:18px}summary{cursor:pointer;font-weight:700;font-size:.94rem;line-height:1.6;padding:8px 0}details p{color:#606a60;font-size:.9rem;line-height:1.8;margin:10px 0 0}
  .free-invitation{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-top:26px}.free-invitation p{font-family:Georgia,serif;font-size:1.3rem;margin:0}.free-invitation a{color:#34523f;font-weight:750;padding:12px 0}.library a:focus-visible,.library summary:focus-visible{outline:3px solid #a44c2d;outline-offset:5px}
  @media(hover:hover){.cover-link:hover{transform:rotate(0) translateY(-6px)}}
  @media(max-width:760px){.library-intro{grid-template-columns:1fr;padding:34px 0;gap:0}.library-note{display:none}.library-intro h1{font-size:2.6rem}.intro-text{font-size:.96rem}.collection{grid-template-columns:1fr;gap:24px}.book-stage{min-height:360px}.cover-link img{width:190px;height:247px}.book-info{padding:24px}.book-info h2{font-size:1.65rem}.library-faq{grid-template-columns:1fr;gap:22px;padding:42px 0}.free-invitation{align-items:flex-start;flex-direction:column;gap:4px}.book-actions .buy-link{flex:1}.library{padding-bottom:36px}}
  @media(prefers-reduced-motion:reduce){.cover-link,.buy-link{transition:none}.cover-link:hover{transform:none}}
</style>
