---
import SantaLoader from './SantaLoader.astro';
---
<section class="meal-conversation" aria-label="Composer votre recherche" data-conversation>
  <div id="conversation-history" class="conversation-history"></div>
  <p id="conversation-announcement" class="conversation-sr" aria-live="polite"></p>
  <form id="conversation-form" novalidate>
    <p id="conversation-step" class="conversation-step"></p>
    <label for="meal-query" id="conversation-question">Qu’avez-vous envie de cuisiner ?</label>
    <p id="conversation-help" class="conversation-help"></p>
    <div id="conversation-choices" class="conversation-choices"></div>
    <div class="conversation-entry"><input id="meal-query" name="answer" type="text" maxlength="300" autocomplete="off" aria-describedby="conversation-help conversation-error" placeholder="Un repas du soir, du poulet…"/><button type="submit" id="conversation-send">Continuer →</button></div>
    <p id="conversation-error" role="alert" hidden></p>
    <button type="button" id="conversation-skip" class="conversation-secondary" hidden>Je n’ai rien de précis</button>
    <button type="button" id="conversation-early" class="conversation-secondary" hidden>Voir déjà les recettes · 2 personnes par défaut, sans limite ajoutée</button>
  </form>
  <div id="conversation-review" hidden>
    <h2 tabindex="-1" id="conversation-review-title">Votre idée prend forme</h2>
    <p id="conversation-recap"></p>
    <div class="conversation-actions"><button type="button" id="conversation-update">Actualiser les recettes</button><button type="button" id="conversation-edit" class="conversation-secondary">Modifier mes réponses</button><button type="button" id="conversation-restart" class="conversation-secondary">Recommencer la discussion</button></div>
  </div>
  <p class="conversation-privacy">L’IA peut aider à comprendre votre demande. Évitez les données personnelles. <a href="/confidentialite/#recherche-ia">Confidentialité</a></p>
  <SantaLoader/>
</section>
<style is:global>
 .meal-conversation{max-width:720px;margin:auto;border:1px solid #dce1cc;border-radius:22px;padding:24px;background:#fffef9;color:#183e30}.meal-conversation [hidden]{display:none!important}.conversation-history{display:flex;flex-direction:column;gap:14px}.conversation-exchange{display:flex;flex-direction:column;gap:8px;font-size:1rem;overflow-wrap:anywhere}.conversation-prompt{align-self:flex-start;background:#edf2df;border-radius:15px 15px 15px 4px;padding:12px 15px}.conversation-answer{align-self:flex-end;border:1px solid #dce1cc;border-radius:15px 15px 4px 15px;padding:10px 14px;max-width:95%;display:flex;flex-wrap:wrap;align-items:center;gap:6px}.meal-conversation button{font:inherit;min-height:44px;padding:10px 15px;border:1px solid #174b38;border-radius:12px;color:white;background:#174b38;cursor:pointer}.meal-conversation button:disabled{opacity:.6;cursor:wait}.meal-conversation .conversation-secondary{color:#174b38;background:transparent;border-color:#c1ceb5}.conversation-answer button{font-size:.85rem;padding:6px 10px}.conversation-step{font-size:.82rem;color:#536154;margin:22px 0 8px}.meal-conversation label{font-size:1.15rem;line-height:1.5;font-weight:700;display:block}.conversation-help{font-size:.92rem;color:#536154;margin:7px 0}.conversation-choices,.conversation-actions{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}.conversation-choices button{background:#edf2df;color:#174b38;border-color:#c1ceb5}.conversation-entry{display:flex;gap:8px;margin-top:14px}.conversation-entry input{flex:1;min-width:0;width:100%;font:inherit;font-size:16px;padding:13px;border:1px solid #94aa91;border-radius:12px;background:white;color:#183e30}.conversation-entry button{flex-shrink:0}.meal-conversation button:focus-visible,.meal-conversation input:focus-visible{outline:3px solid #7b9844;outline-offset:3px}.conversation-privacy{font-size:.82rem;line-height:1.6;color:#536154;margin-top:20px}.conversation-privacy a{text-decoration:underline;color:#174b38}.conversation-secondary{margin-top:8px}#conversation-error{color:#982f36;font-size:.95rem;margin:10px 0}#conversation-recap{line-height:1.7;margin:8px 0;overflow-wrap:anywhere}#conversation-review h2{font:500 1.45rem Georgia,serif;margin-top:24px}.conversation-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
 #conversation-form{scroll-margin-top:100px}#conversation-review-title{scroll-margin-top:100px}
 @media(max-width:540px){.meal-conversation{padding:16px;border-radius:18px}.conversation-entry{flex-direction:column}.conversation-entry button{width:100%}.conversation-actions{flex-direction:column}.conversation-answer{max-width:100%}.conversation-secondary{font-size:.95rem}}
</style>
