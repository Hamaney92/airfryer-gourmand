---
interface Props { pageType?: string; }
const { pageType = 'page' } = Astro.props;
// Les pages de contenu proposent une offre contextuelle après la réponse.
const show = Astro.url.pathname === '/';
---
{show && <aside class="books-banner" aria-label="Nos livres de cuisine"><div class="wrap books-banner-inner">
  <p>Petites portions ou anti-gaspi : nos idées aussi sur papier.</p>
  <a href="/livre/" data-book-entry data-placement="books_banner_compact" data-page-type={pageType}>Choisir mon livre →</a>
</div></aside>}
<style>
  .books-banner{background:#173e32;color:#fff;border-bottom:2px solid #e9bb75}.books-banner-inner{display:flex;align-items:center;justify-content:space-between;gap:8px 18px;padding-top:6px;padding-bottom:6px}.books-banner p{font-size:.85rem;margin:0}.books-banner a{display:inline-flex;align-items:center;min-height:44px;color:#f6d9ad;font-size:.87rem;font-weight:750;white-space:nowrap;text-decoration:underline;text-underline-offset:4px}
  .books-banner a:focus-visible{outline:3px solid #fff;outline-offset:3px}
  @media(max-width:600px){.books-banner p{display:none}.books-banner-inner{justify-content:center;padding-top:0;padding-bottom:0}}
  @media print{.books-banner{display:none}}
</style>
