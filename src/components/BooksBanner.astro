---
interface Props { pageType?: string; }
const { pageType = 'page' } = Astro.props;
// Les pages de contenu proposent une offre contextuelle après la réponse.
const show = Astro.url.pathname === '/';
---
{show && <aside class="books-banner" aria-label="Nos livres de cuisine"><div class="wrap books-banner-inner">
  <div class="books-banner-copy"><span class="books-banner-badge">À découvrir</span><p><strong>Deux livres, une cuisine plus simple.</strong><span>Petites portions et recettes anti-gaspi à garder sous la main.</span></p></div>
  <a class="books-banner-cta" href="/livre/" data-book-entry data-placement="books_banner_compact" data-page-type={pageType}><span>Voir les livres</span><span aria-hidden="true">→</span></a>
</div></aside>}
<style>
  .books-banner{position:relative;overflow:hidden;background:linear-gradient(105deg,#173e32 0%,#1e5945 48%,#173e32 100%);color:#fff;border-bottom:2px solid #e9bb75}.books-banner::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 25%,rgba(255,255,255,.12) 42%,transparent 58%);transform:translateX(-120%);animation:books-shimmer 7s ease-in-out infinite}.books-banner-inner{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:12px 22px;padding-top:10px;padding-bottom:10px}.books-banner-copy{display:flex;align-items:center;gap:11px;min-width:0}.books-banner-badge{display:inline-flex;align-items:center;min-height:24px;padding:2px 9px;border:1px solid rgba(255,255,255,.38);border-radius:999px;color:#ffe2af;font-size:.68rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}.books-banner p{display:flex;flex-wrap:wrap;align-items:baseline;gap:3px 9px;margin:0;font-size:.84rem;line-height:1.35}.books-banner p strong{font-size:.92rem}.books-banner p span{color:#dcebe5}.books-banner-cta{display:inline-flex;align-items:center;gap:9px;min-height:42px;padding:0 15px;border:1px solid #f5d08f;border-radius:999px;background:#f7c76b;color:#173e32;font-size:.83rem;font-weight:850;white-space:nowrap;text-decoration:none;box-shadow:0 4px 12px rgba(0,0,0,.16);transition:transform .2s ease,background-color .2s ease,box-shadow .2s ease}.books-banner-cta span:last-child{font-size:1.15rem;line-height:1;transition:transform .2s ease}.books-banner-cta:hover{background:#ffda8e;box-shadow:0 6px 16px rgba(0,0,0,.2);transform:translateY(-1px)}.books-banner-cta:hover span:last-child{transform:translateX(3px)}.books-banner-cta:focus-visible{outline:3px solid #fff;outline-offset:3px}
  @keyframes books-shimmer{0%,55%{transform:translateX(-120%)}75%,100%{transform:translateX(120%)}}
  @media(max-width:600px){.books-banner-inner{gap:8px;padding-top:8px;padding-bottom:8px}.books-banner-copy{gap:8px}.books-banner-badge{font-size:.6rem;padding-inline:7px}.books-banner p strong{font-size:.82rem}.books-banner p span{display:none}.books-banner-cta{min-height:38px;padding-inline:12px;font-size:.76rem;gap:5px}}
  @media(prefers-reduced-motion:reduce){.books-banner::after{animation:none}.books-banner-cta,.books-banner-cta span:last-child{transition:none}}
  @media print{.books-banner{display:none}}
</style>
