---
import NewsletterForm from './NewsletterForm.astro';
interface Props { titre: string; url: string; }
const { titre, url } = Astro.props;
const mail = `mailto:?subject=${encodeURIComponent(titre)}&body=${encodeURIComponent(`Une recette à garder : ${titre}\n${url}`)}`;
---
<aside class="save-box" aria-label="Garder cette recette">
  <h2>Gardez cette recette pour plus tard</h2>
  <p>Sans inscription : envoyez le lien avec votre messagerie. Votre adresse ne nous est pas transmise.</p>
  <a class="save-link" href={mail}>Ouvrir ma messagerie →</a>
  <details>
    <summary>Recevoir aussi nos recettes et offres par email</summary>
    <p>Vous pouvez aussi choisir de vous inscrire séparément à notre newsletter recettes et offres.</p>
    <NewsletterForm title={titre} url={url} source="recipe" />
  </details>
</aside>
<style>
  .save-box{background:var(--cream);border:1px solid #e8c7a9;border-radius:16px;padding:22px;margin:26px 0}
  .save-box h2{font-size:1.15rem;margin:0 0 8px}.save-box p{font-size:.92rem;color:#5f5147;margin:8px 0}
  .save-link{display:inline-block;padding:10px 0;color:var(--brand-d);font-weight:750;text-decoration:underline;min-height:44px}
  details{border-top:1px solid #e8c7a9;padding-top:12px;margin-top:10px}summary{font-weight:700;cursor:pointer;min-height:44px;padding:8px 0}
  a:focus-visible,summary:focus-visible{outline:3px solid var(--brand);outline-offset:3px}
  @media print{.save-box{display:none}}
</style>
