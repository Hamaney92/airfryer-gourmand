---
// Pop-up « tableau des temps de cuisson » — aimant UNIVERSEL, complémentaire du bloc
// « Enregistrer cette recette » qui, lui, est contextuel (il offre LA recette lue).
//
// DÉCLENCHEMENT — jamais à l'arrivée, volontairement :
//   • Google dégrade les pages dont le contenu est masqué par un interstitiel dès
//     l'arrivée sur mobile. Or le trafic Google est notre seul canal à forte attention
//     (2 min 41 s contre 18 s pour Pinterest) : on ne le sacrifie pas.
//   • Un visiteur Pinterest arrive dans un navigateur intégré, sans intention forte.
//     Un pop-up avant qu'il ait vu la photo, c'est le bouton retour immédiat.
//   → Ordinateur : intention de sortie (souris vers le haut).
//   → Mobile : 50 % de scroll OU 45 s, le premier des deux.
// Affiché une seule fois, puis mémorisé 30 jours dans localStorage.
import { MAILERLITE_FORM_ACTION } from '../lib/site';
const configured = Boolean(MAILERLITE_FORM_ACTION);
---

<div id="pdfpop" class="pdfpop" hidden aria-hidden="true">
  <div class="pdfpop-back" data-close></div>
  <div class="pdfpop-box" role="dialog" aria-modal="true" aria-labelledby="pdfpop-t">
    <button class="pdfpop-x" data-close aria-label="Fermer">&times;</button>
    <div class="pdfpop-emoji">📄</div>
    <strong id="pdfpop-t">Le tableau des temps de cuisson, gratuit</strong>
    <p>Tous les aliments, température et durée, sur une seule page à coller sur le frigo. Fini le téléphone plein de farine pendant que ça cuit.</p>

    {configured ? (
      <form class="pdfpop-form" method="post" action={MAILERLITE_FORM_ACTION} target="_blank">
        <input type="hidden" name="fields[recette]" value="Tableau des temps de cuisson" />
        <input type="hidden" name="fields[url_recette]" value="https://airfryergourmand.fr/tableau-temps-cuisson-air-fryer.pdf" />
        <input type="email" name="fields[email]" required placeholder="ton@email.fr" aria-label="Ton adresse email" />
        <button type="submit">Recevoir le tableau →</button>
      </form>
    ) : (
      <a class="pdfpop-cta" href="/tableau-temps-cuisson-air-fryer.pdf" download>Télécharger le PDF →</a>
    )}

    <button class="pdfpop-no" data-close>Non merci</button>
  </div>
</div>

<style>
  .pdfpop{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center}
  .pdfpop[hidden]{display:none}
  .pdfpop-back{position:absolute;inset:0;background:rgba(30,22,16,.55)}
  .pdfpop-box{position:relative;background:#fffaf5;border:1px solid #ffd6b8;border-radius:20px;padding:30px 28px 22px;max-width:430px;width:calc(100% - 32px);box-shadow:0 24px 60px rgba(0,0,0,.28);text-align:center}
  .pdfpop-emoji{font-size:2.2rem;line-height:1;margin-bottom:8px}
  .pdfpop-box strong{display:block;font-size:1.3rem;color:var(--brand-d);margin-bottom:8px;letter-spacing:-.3px}
  .pdfpop-box p{margin:0 0 18px;color:#5f5147;font-size:.95rem;line-height:1.5}
  .pdfpop-form{display:flex;flex-direction:column;gap:10px}
  .pdfpop-form input{border:1px solid var(--line);padding:13px 15px;border-radius:11px;font-size:1rem;width:100%}
  .pdfpop-form button,.pdfpop-cta{background:var(--brand);color:#fff;font-weight:800;border:none;padding:13px 20px;border-radius:11px;cursor:pointer;font-size:1rem;text-decoration:none;display:block}
  .pdfpop-x{position:absolute;top:10px;right:14px;background:none;border:none;font-size:1.6rem;line-height:1;color:#b5a698;cursor:pointer}
  .pdfpop-no{display:block;margin:12px auto 0;background:none;border:none;color:#9a8c7d;font-size:.85rem;cursor:pointer;text-decoration:underline}
</style>

<script is:inline>
  (function () {
    var KEY = 'afg_pdfpop_vu';
    var el = document.getElementById('pdfpop');
    if (!el) return;

    try {
      var vu = localStorage.getItem(KEY);
      if (vu && Date.now() - parseInt(vu, 10) < 30 * 24 * 3600 * 1000) return;
    } catch (e) {}

    var ouvert = false;
    function fermer() {
      el.hidden = true;
      el.setAttribute('aria-hidden', 'true');
      try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {}
    }
    function ouvrir() {
      if (ouvert) return;
      ouvert = true;
      el.hidden = false;
      el.setAttribute('aria-hidden', 'false');
      nettoyer();
    }
    function nettoyer() {
      document.removeEventListener('mouseout', surSortie);
      window.removeEventListener('scroll', surScroll);
      if (minuteur) clearTimeout(minuteur);
    }

    el.querySelectorAll('[data-close]').forEach(function (b) {
      b.addEventListener('click', fermer);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !el.hidden) fermer();
    });

    var mobile = window.matchMedia('(max-width: 820px)').matches;
    var minuteur = null;

    function surSortie(e) {
      // Intention de sortie : le curseur quitte la fenêtre par le haut.
      if (!e.relatedTarget && e.clientY <= 8) ouvrir();
    }
    function surScroll() {
      var h = document.documentElement.scrollHeight - window.innerHeight;
      if (h > 0 && window.scrollY / h >= 0.5) ouvrir();
    }

    if (mobile) {
      window.addEventListener('scroll', surScroll, { passive: true });
      minuteur = setTimeout(ouvrir, 45000);
    } else {
      // Sur ordinateur on laisse d'abord le visiteur lire un peu.
      setTimeout(function () {
        document.addEventListener('mouseout', surSortie);
      }, 12000);
    }
  })();
</script>
