---
// Invitation dans le flux de lecture : aucun déclenchement automatique ni masque.
import NewsletterForm from './NewsletterForm.astro';
import { SITE } from '../lib/site';
const pathname = Astro.url.pathname;
const show = pathname === '/' || /^\/(categorie|dossiers)\//.test(pathname);
---
{show && <aside class="pdf-invitation wrap" aria-label="Tableau de cuisson gratuit">
  <div class="pdf-invitation-box">
    <h2>Les temps de cuisson à portée de main</h2>
    <p>Gardez le tableau sur votre téléphone ou imprimez-le pour la cuisine.</p>
    <a class="cta" href="/tableau-temps-cuisson-air-fryer.pdf" download data-placement="inline_pdf_invitation">Télécharger le tableau gratuit →</a>
    <p class="free-note">Sans inscription, sans email obligatoire.</p>
    <details><summary>Recevoir le tableau et m’abonner à la newsletter</summary><NewsletterForm title="Tableau des temps de cuisson" url={`${SITE.url}/tableau-temps-cuisson-air-fryer.pdf`} source="inline_pdf" /></details>
  </div>
</aside>}
<style>
  .pdf-invitation-box{border:1px solid #e8c7a9;border-radius:16px;background:var(--cream);padding:24px;margin:24px 0 36px;max-width:740px}
  h2{font-size:1.3rem;margin:0 0 8px}p{color:var(--muted);margin:8px 0 14px}.free-note{font-size:.85rem}.cta{font-size:.95rem}
  details{border-top:1px solid #e8c7a9;padding-top:8px}summary{cursor:pointer;font-weight:700;min-height:44px;padding:10px 0}
  summary:focus-visible{outline:3px solid var(--brand);outline-offset:3px}
  @media print{.pdf-invitation{display:none}}
</style>
