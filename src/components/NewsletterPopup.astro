---
import { NEWSLETTER_FORM_URL } from '../lib/site';
interface Props { renderDialog?: boolean; automatic?: boolean; }
const { renderDialog = true, automatic = false } = Astro.props;
---
{renderDialog && <dialog class="newsletter-popup" data-newsletter-dialog data-auto-newsletter={automatic ? '' : undefined} aria-labelledby="newsletter-popup-title">
  <button type="button" data-newsletter-close aria-label="Fermer le formulaire newsletter">×</button>
  <h2 id="newsletter-popup-title">Votre prochaine idée air fryer commence ici</h2>
  <p>Recevez nos recettes faciles et conseils dans votre boîte mail.</p>
  <p class="disclaimer">Inscription facultative : recettes, conseils et offres sur nos livres et produits, parfois affiliés. Désinscription à tout moment. Données traitées via MailerLite. <a href="/confidentialite/">Confidentialité</a>.</p>
  <iframe title="Formulaire newsletter Airfryer Gourmand" data-newsletter-url={NEWSLETTER_FORM_URL} referrerpolicy="strict-origin-when-cross-origin"></iframe>
  <p class="disclaimer">Le formulaire ne s’affiche pas ? <a href="/newsletter/">Réessayer sur notre page newsletter</a>.</p>
</dialog>}
<script>
  import { initNewsletterPopup } from '../lib/newsletter-popup.mjs';
  initNewsletterPopup(document.querySelector('[data-newsletter-dialog]'));
</script>
<style>
  .newsletter-popup{width:min(620px,calc(100vw - 24px));max-height:90dvh;margin:auto;padding:24px;border:0;border-radius:18px;background:#fffaf4;box-shadow:0 15px 60px #0005;color:var(--ink)}
  .newsletter-popup::backdrop{background:#182c2570}.newsletter-popup h2{font-size:1.35rem;line-height:1.3;margin:0 32px 12px 0}.newsletter-popup p{margin:8px 0;line-height:1.5}.disclaimer{font-size:.78rem;color:var(--muted)}
  .newsletter-popup button{position:absolute;right:8px;top:8px;min-width:44px;min-height:44px;border:0;background:transparent;font-size:26px;cursor:pointer}.newsletter-popup iframe{display:block;width:100%;height:55dvh;min-height:230px;border:0;background:#fff}.newsletter-popup a{text-decoration:underline}.newsletter-popup button:focus-visible,.newsletter-popup a:focus-visible{outline:3px solid var(--brand);outline-offset:3px}
  @media print{.newsletter-popup{display:none!important}}
</style>
