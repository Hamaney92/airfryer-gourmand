---
import NewsletterSignup from './NewsletterSignup.astro';
interface Props { renderDialog?: boolean; automatic?: boolean; }
const { renderDialog = true } = Astro.props;
---
{renderDialog && <dialog class="newsletter-popup" data-newsletter-dialog aria-labelledby="newsletter-popup-title">
  <button type="button" data-newsletter-close aria-label="Fermer le formulaire newsletter">×</button>
  <h2 id="newsletter-popup-title">La newsletter Airfryer Gourmand</h2>
  <NewsletterSignup />
</dialog>}
<script>
  import { initNewsletterPopup } from '../lib/newsletter-popup.mjs';
  initNewsletterPopup(document.querySelector('[data-newsletter-dialog]'));
</script>
<style>
  .newsletter-popup{width:min(460px,calc(100vw - 24px));max-height:90dvh;margin:auto;padding:24px;border:0;border-radius:18px;background:#fffaf4;box-shadow:0 15px 60px #0005;color:var(--ink)}
  .newsletter-popup::backdrop{background:#182c2570}.newsletter-popup h2{font-size:1.25rem;line-height:1.3;margin:0 32px 16px 0}
  .newsletter-popup [data-newsletter-close]{position:absolute;right:8px;top:8px;min-width:44px;min-height:44px;border:0;background:transparent;font-size:26px;cursor:pointer}
  @media print{.newsletter-popup{display:none!important}}
</style>
