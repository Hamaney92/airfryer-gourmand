---
interface Props { inverse?: boolean }
const {inverse=false}=Astro.props;
---
<a href="/" class:list={['logo','ag-brand',{'ag-inverse':inverse}]} aria-label="Airfryer Gourmand — accueil">
  <img src="/img/brand/afg-sourire-logo.webp" width="600" height="200" alt=""/>
</a>
<style>
  .ag-brand{display:inline-flex;align-items:center;flex-shrink:0;line-height:1}.ag-brand img{display:block;flex-shrink:0;width:180px;height:60px;object-fit:contain;border-radius:8px}
  @media(max-width:400px){.ag-brand img{width:156px;height:52px}}
</style>
