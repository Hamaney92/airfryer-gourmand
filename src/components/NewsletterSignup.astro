---
import { NEWSLETTER_FORM_ACTION } from '../lib/site';
---
<form data-newsletter-form action={NEWSLETTER_FORM_ACTION} method="post">
  <div class="newsletter-fields">
    <input type="email" name="fields[email]" aria-label="Votre adresse e-mail" placeholder="Votre adresse e-mail" autocomplete="email" required maxlength="254" />
    <button type="submit">Je m’inscris</button>
  </div>
  <input type="hidden" name="ml-submit" value="1" />
  <input type="hidden" name="anticsrf" value="true" />
  <p class="newsletter-note">Chaque semaine par e-mail : recettes, conseils et offres, parfois affiliées. Désinscription à tout moment. <a href="/confidentialite/">Confidentialité</a></p>
  <p class="newsletter-status" role="status" data-newsletter-status></p>
</form>
<script>
  import { requestMailerLiteSignup } from '../lib/recipe-email.mjs';

  document.querySelectorAll<HTMLFormElement>('[data-newsletter-form]').forEach(form => {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-newsletter-status]')!;
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (button.disabled) return;
      button.disabled = true;
      status.textContent = 'Inscription en cours…';
      try {
        await requestMailerLiteSignup(form, fetch, AbortSignal.timeout(20000));
        form.reset();
        status.textContent = 'Merci ! Votre demande d’inscription a été enregistrée.';
      } catch {
        status.textContent = 'Votre inscription n’a pas pu être confirmée. Réessayez dans un instant.';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
<style>
  .newsletter-fields { display: flex; gap: 8px; }
  .newsletter-fields input { flex: 1; min-width: 0; min-height: 46px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; font: inherit; color: var(--ink); background: white; }
  .newsletter-fields button { min-height: 46px; padding: 10px 14px; border: 0; border-radius: 8px; background: var(--brand-d); color: white; font: inherit; font-weight: 700; cursor: pointer; }
  .newsletter-fields button:disabled { opacity: .65; cursor: wait; }
  .newsletter-note, .newsletter-status { margin: 8px 0 0; font-size: .82rem; line-height: 1.5; color: var(--muted); }
  .newsletter-note a { text-decoration: underline; }
  .newsletter-status:empty { margin: 0; }
  @media (max-width: 420px) { .newsletter-fields { flex-direction: column; } }
</style>
