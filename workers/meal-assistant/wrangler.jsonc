{
  "name": "airfryer-assistant-pilote",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "TRIAL_ENABLED": "false" },
  "ratelimits": [{"name":"AI_LIMITER","namespace_id":"2026111601","simple":{"limit":10,"period":60}}], "observability": { "enabled": false }
}

